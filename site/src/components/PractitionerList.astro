---
// Compact practitioner rows for service pages: photo, name, roles, status, profile link.
import { getEntries, type CollectionEntry } from 'astro:content';
import Photo from './Photo.astro';
import Icon from './Icon.astro';

interface Props {
  refs: { collection: 'team'; id: string }[];
}

const people = (await getEntries(Astro.props.refs)) as CollectionEntry<'team'>[];
---

<ul class="people" role="list">
  {
    people.map((p) => (
      <li class="person">
        <Photo src={p.data.photo} alt="" ratio="1 / 1" class="person__photo" sizes="7rem" widths={[160, 320]} note={p.data.photoNote?.split(' ')[0]} />
        <div class="person__body">
          <h3 class="h4">
            <a href={`/team/${p.id}`}>{p.data.name}</a>
          </h3>
          <p class="person__titles">{p.data.titles.join(' · ')}</p>
          {p.data.status && <p class="person__status">{p.data.status}</p>}
        </div>
        <Icon name="chevron-right" size={20} class="person__chev" />
      </li>
    ))
  }
</ul>

<style>
  .people {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
  }

  .person {
    position: relative;
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-s);
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    transition: box-shadow 0.2s var(--ease);
  }

  .person:hover {
    box-shadow: var(--shadow-m);
  }

  :global(.person__photo) {
    border-radius: var(--radius);
    overflow: hidden;
  }

  .person :global(.photo--placeholder) {
    padding: var(--space-3xs);
  }

  .person :global(.photo--placeholder .todo) {
    font-size: 0.6875rem;
  }

  .person__body {
    display: grid;
    gap: var(--space-3xs);
  }

  /* The whole row is clickable via the name link. */
  .person__body a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .person__body a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-l);
  }

  .person__body a:focus-visible {
    outline: none;
  }

  .person__body a:focus-visible::after {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .person__titles {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .person__status {
    justify-self: start;
    margin-top: var(--space-3xs);
    padding: 0.15em 0.7em;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  :global(.person__chev) {
    color: var(--color-ink-muted);
  }
</style>

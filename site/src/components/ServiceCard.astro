---
import type { CollectionEntry } from 'astro:content';
import Photo from './Photo.astro';
import Icon from './Icon.astro';

interface Props {
  service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
const { title, summary, image, imagePosition, imageNote } = service.data;
---

<a class="service-card" href={`/${service.id}`}>
  <Photo src={image} alt="" note={imageNote} position={imagePosition} ratio="3 / 2" sizes="(min-width: 62em) 33vw, (min-width: 40em) 50vw, 100vw" />
  <div class="service-card__body">
    <h3 class="h4">{title}</h3>
    <p>{summary}</p>
    <span class="service-card__more" aria-hidden="true">Learn more <Icon name="arrow-right" size={16} /></span>
  </div>
</a>

<style>
  .service-card {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    background: var(--color-bg);
    border-radius: var(--radius-l);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      box-shadow 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .service-card:hover {
    box-shadow: var(--shadow-m);
    transform: translateY(-2px);
  }

  .service-card__body {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-2xs);
    padding: var(--space-m);
  }

  .service-card__body p {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .service-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-top: var(--space-2xs);
    color: var(--color-link);
    font-family: var(--font-display);
    font-weight: 650;
  }

  .service-card:hover .service-card__more {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>

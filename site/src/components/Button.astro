---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  size?: 's' | 'm' | 'l';
  icon?: IconName;
  class?: string;
  [key: string]: unknown;
}

const { href, variant = 'primary', size = 'm', icon, class: className, ...rest } = Astro.props;
---

<a href={href} class:list={['btn', `btn--${variant}`, `btn--${size}`, className]} {...rest}>
  {icon && <Icon name={icon} size={size === 's' ? 18 : 20} />}
  <span><slot /></span>
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    min-height: 2.75rem;
    padding: 0.7em 1.4em;
    border: 1.5px solid transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.005em;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn--s {
    padding: 0.55em 1.1em;
    font-size: var(--step--1);
  }

  .btn--l {
    min-height: 3.25rem;
    padding: 0.85em 1.75em;
    font-size: var(--step-1);
  }

  /* Colours come from --btn-bg/--btn-ink, which switch automatically inside .on-brand. */
  .btn--primary {
    background: var(--btn-bg);
    color: var(--btn-ink);
  }

  .btn--primary:hover {
    background: color-mix(in srgb, var(--btn-bg) 84%, #000);
    color: var(--btn-ink);
  }

  .btn--secondary {
    border-color: currentColor;
    background: transparent;
    color: inherit;
  }

  .btn--secondary:hover {
    background: color-mix(in srgb, currentColor 8%, transparent);
    color: inherit;
  }
</style>

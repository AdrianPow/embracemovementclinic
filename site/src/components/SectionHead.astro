---
// Section heading block: eyebrow, heading, optional intro, optional link on the right.
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  intro?: string;
  link?: { href: string; label: string };
  as?: 'h2' | 'h3';
}

const { id, title, eyebrow, intro, link, as: Heading = 'h2' } = Astro.props;
---

<div class="section-head">
  <div class="section-head__text">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Heading id={id}>{title}</Heading>
    {intro && <p class="section-head__intro">{intro}</p>}
  </div>
  {
    link && (
      <a class="section-head__link" href={link.href}>
        {link.label} <Icon name="arrow-right" size={18} />
      </a>
    )
  }
</div>

<style>
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
    margin-bottom: var(--space-l);
  }

  .section-head__text {
    display: grid;
    gap: var(--space-xs);
    max-width: 46rem;
  }

  .section-head__intro {
    color: var(--color-ink-muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .section-head__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-weight: 650;
  }
</style>

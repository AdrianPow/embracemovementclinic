---
// Photo cards for the services, used on Home and Services, in two labelled groups: classes first
// (owner's choice, 7 Nov 2026), then one-on-one appointments.
// Wide screens: a tall classes card beside the one-on-one services in a 2×2 grid.
// Phones: compact rows (photo beside text).
import type { CollectionEntry } from 'astro:content';
import Photo from './Photo.astro';

interface Props {
  /** Services in display order. */
  services: CollectionEntry<'services'>[];
}

const { services } = Astro.props;
const groups = [
  { kind: 'classes', label: 'Classes', list: services.filter((s) => s.data.kind === 'class') },
  { kind: 'appointments', label: 'One-on-one appointments', list: services.filter((s) => s.data.kind === 'appointment') },
];
---

<div class="service-groups">
  {
    groups.map(
      ({ kind, label, list }) =>
        list.length > 0 && (
          <>
          <h3 class:list={['eyebrow', 'group-label', `group-label--${kind}`]}>
            {kind === 'appointments' ? (
              <>
                <span class="nowrap">One-on-one</span> appointments
              </>
            ) : (
              label
            )}
          </h3>
          <ul class:list={['cards', `cards--${kind}`]} role="list">
            {list.map((s) => {
              // Card titles sit under their group's small heading ("One-on-one appointments", "Classes").
              return (
                <li class="card">
                  <a class="hover-card" href={`/${s.id}`}>
                    <Photo
                      src={s.data.image}
                      alt=""
                      note={s.data.imageNote}
                      position={s.data.imagePosition}
                      ratio="3 / 2"
                      widths={[400, 640, 960]}
                      sizes="(min-width: 62em) 30vw, (min-width: 40em) 50vw, 100vw"
                    />
                    <div class="card__body">
                      <h4 class="card__title">{s.data.title}</h4>
                      <p class="card__blurb">{s.data.blurb ?? s.data.summary}</p>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
          </>
        ),
    )
  }
</div>

<style>
  .service-groups {
    display: grid;
    gap: var(--space-m);
  }

  .group-label {
    margin-bottom: calc(var(--space-xs) - var(--space-m));
  }

  .cards {
    display: grid;
    gap: var(--space-m);
  }

  @media (min-width: 40em) {
    .cards--appointments {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 40em) and (max-width: 61.99em) {
    .cards--classes :global(.photo) {
      aspect-ratio: 2 / 1 !important;
    }
  }

  /* Below wide screens the one-on-one group follows the classes card: a rule and its label set it apart. */
  @media (max-width: 61.99em) {
    .group-label--appointments {
      margin-top: var(--space-s);
      padding-top: var(--space-l);
      border-top: 1px solid var(--color-line);
    }
  }

  /* Wide screens: the classes card on the left, the one-on-one 2×2 grid beside it, labels and tops aligned. */
  @media (min-width: 62em) {
    .service-groups {
      grid-template-columns: 1.1fr 2fr;
      grid-template-rows: auto 1fr;
      gap: var(--space-xs) var(--space-xl);
    }

    .group-label {
      margin-bottom: 0;
    }

    .group-label--appointments {
      grid-column: 2;
      grid-row: 1;
    }

    .cards--appointments {
      grid-column: 2;
      grid-row: 2;
    }

    .group-label--classes {
      grid-column: 1;
      grid-row: 1;
    }

    .cards--classes {
      grid-column: 1;
      grid-row: 2;
      grid-template-rows: 1fr;
    }

    .cards--classes .card a {
      grid-template-rows: 1fr auto;
    }

    .cards--classes :global(picture) {
      display: block;
      position: relative;
      min-height: 18rem;
    }

    .cards--classes :global(.photo) {
      position: absolute;
      inset: 0;
      height: 100%;
      aspect-ratio: auto !important;
    }
  }

  .card a {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    background: var(--color-bg);
    color: var(--color-ink);
    text-decoration: none;
  }

  @media (max-width: 39.99em) {
    .cards {
      gap: var(--space-s);
    }

    .card a {
      grid-template-columns: 6.5rem 1fr;
      grid-template-rows: none;
    }

    .card :global(picture) {
      display: block;
      position: relative;
    }

    .card :global(.photo) {
      position: absolute;
      inset: 0;
      height: 100%;
      aspect-ratio: auto !important;
    }

    .card__body {
      padding: var(--space-s);
    }

    .card__title {
      font-size: var(--step-0);
    }

    .card__blurb {
      font-size: var(--step--1);
    }
  }

  .card__body {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding: var(--space-m);
  }

  .card__title {
    font-size: var(--step-1);
  }

  @media (hover: hover) {
    .card a:hover .card__title {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }

  .card__blurb {
    color: var(--color-ink-muted);
  }

</style>

---
// Photo cards for the services: on wide screens, the one-on-one services in a 2×2 grid beside
// a tall card for classes; compact rows (photo beside text) on phones. Used on Home and Services.
import type { CollectionEntry } from 'astro:content';
import Photo from './Photo.astro';

interface Props {
  /** Services in display order. */
  services: CollectionEntry<'services'>[];
  /** Heading level for each card title. */
  as?: 'h3' | 'h4';
}

const { services, as: Heading = 'h3' } = Astro.props;
---

<ul class="cards" role="list">
  {
    services.map((s) => (
      <li class:list={['card', s.data.kind === 'class' && 'card--feature']}>
        <a href={`/${s.id}`}>
          <Photo
            src={s.data.image}
            alt=""
            note={s.data.imageNote}
            position={s.data.imagePosition}
            ratio="3 / 2"
            widths={[400, 640, 960]}
            sizes="(min-width: 62em) 30vw, (min-width: 40em) 50vw, 100vw"
          />
          <div class="card__body">
            <p class="card__kind">{s.data.kind === 'class' ? 'Small group classes' : 'One-on-one'}</p>
            <Heading class="card__title">{s.data.title}</Heading>
            <p class="card__blurb">{s.data.blurb ?? s.data.summary}</p>
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .cards {
    display: grid;
    gap: var(--space-m);
  }

  @media (min-width: 40em) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .card--feature {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 40em) and (max-width: 61.99em) {
    .card--feature :global(.photo) {
      aspect-ratio: 2 / 1 !important;
    }
  }

  @media (min-width: 62em) {
    .cards {
      grid-template-columns: 1fr 1fr 1.1fr;
    }

    .card--feature {
      grid-column: 3;
      grid-row: 1 / span 2;
    }

    .cards .card--feature a {
      grid-template-rows: 1fr auto;
    }

    .card--feature :global(picture) {
      display: block;
      position: relative;
      min-height: 18rem;
    }

    .card--feature :global(.photo) {
      position: absolute;
      inset: 0;
      height: 100%;
      aspect-ratio: auto !important;
    }
  }

  .card a {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    background: var(--color-bg);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      box-shadow 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .card a:hover {
    box-shadow: var(--shadow-m);
    transform: translateY(-2px);
  }

  @media (max-width: 39.99em) {
    .cards {
      gap: var(--space-s);
    }

    .card a {
      grid-template-columns: 6.5rem 1fr;
      grid-template-rows: none;
    }

    .card :global(picture) {
      display: block;
      position: relative;
    }

    .card :global(.photo) {
      position: absolute;
      inset: 0;
      height: 100%;
      aspect-ratio: auto !important;
    }

    .card__body {
      padding: var(--space-s);
    }

    .card__title {
      font-size: var(--step-0);
    }

    .card__blurb {
      font-size: var(--step--1);
    }
  }

  .card__body {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding: var(--space-m);
  }

  .card__kind {
    color: var(--color-eyebrow);
    font-size: var(--step--1);
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .card__title {
    font-size: var(--step-1);
  }

  .card a:hover .card__title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .card__blurb {
    color: var(--color-ink-muted);
  }

</style>

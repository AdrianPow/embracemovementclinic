---
// Photo cards for the services, used on Home and Services. One heading labels the one-on-one
// services, instead of a label on every card; the classes card's own title says what it is.
// Wide screens: the one-on-one services in a 2×2 grid beside a tall classes card.
// Phones: compact rows (photo beside text).
import type { CollectionEntry } from 'astro:content';
import Photo from './Photo.astro';

interface Props {
  /** Services in display order. */
  services: CollectionEntry<'services'>[];
}

const { services } = Astro.props;
const groups = [
  { kind: 'appointments', list: services.filter((s) => s.data.kind === 'appointment') },
  { kind: 'classes', list: services.filter((s) => s.data.kind === 'class') },
];
---

<div class="service-groups">
  <h3 class="eyebrow group-label">One-on-one appointments</h3>
  {
    groups.map(
      ({ kind, list }) =>
        list.length > 0 && (
          <ul class:list={['cards', `cards--${kind}`]} role="list">
            {list.map((s) => {
              // Under the "One-on-one appointments" heading, or a heading of its own for classes.
              const Heading = kind === 'classes' ? 'h3' : 'h4';
              return (
                <li class="card">
                  <a href={`/${s.id}`}>
                    <Photo
                      src={s.data.image}
                      alt=""
                      note={s.data.imageNote}
                      position={s.data.imagePosition}
                      ratio="3 / 2"
                      widths={[400, 640, 960]}
                      sizes="(min-width: 62em) 30vw, (min-width: 40em) 50vw, 100vw"
                    />
                    <div class="card__body">
                      <Heading class="card__title">{s.data.title}</Heading>
                      <p class="card__blurb">{s.data.blurb ?? s.data.summary}</p>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        ),
    )
  }
</div>

<style>
  .service-groups {
    display: grid;
    gap: var(--space-m);
  }

  .group-label {
    margin-bottom: calc(var(--space-xs) - var(--space-m));
  }

  .cards {
    display: grid;
    gap: var(--space-m);
  }

  @media (min-width: 40em) {
    .cards--appointments {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 40em) and (max-width: 61.99em) {
    .cards--classes :global(.photo) {
      aspect-ratio: 2 / 1 !important;
    }
  }

  /* Wide screens: the heading and 2×2 grid on the left, the classes card full height on the right. */
  @media (min-width: 62em) {
    .service-groups {
      grid-template-columns: 2fr 1.1fr;
      grid-template-rows: auto 1fr;
      gap: var(--space-xs) var(--space-m);
    }

    .group-label {
      margin-bottom: 0;
    }

    .cards--appointments {
      grid-column: 1;
      grid-row: 2;
    }

    .cards--classes {
      grid-column: 2;
      grid-row: 1 / span 2;
      grid-template-rows: 1fr;
    }

    .cards--classes .card a {
      grid-template-rows: 1fr auto;
    }

    .cards--classes :global(picture) {
      display: block;
      position: relative;
      min-height: 18rem;
    }

    .cards--classes :global(.photo) {
      position: absolute;
      inset: 0;
      height: 100%;
      aspect-ratio: auto !important;
    }
  }

  .card a {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    background: var(--color-bg);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      box-shadow 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .card a:hover {
    box-shadow: var(--shadow-m);
    transform: translateY(-2px);
  }

  @media (max-width: 39.99em) {
    .cards {
      gap: var(--space-s);
    }

    .card a {
      grid-template-columns: 6.5rem 1fr;
      grid-template-rows: none;
    }

    .card :global(picture) {
      display: block;
      position: relative;
    }

    .card :global(.photo) {
      position: absolute;
      inset: 0;
      height: 100%;
      aspect-ratio: auto !important;
    }

    .card__body {
      padding: var(--space-s);
    }

    .card__title {
      font-size: var(--step-0);
    }

    .card__blurb {
      font-size: var(--step--1);
    }
  }

  .card__body {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding: var(--space-m);
  }

  .card__title {
    font-size: var(--step-1);
  }

  .card a:hover .card__title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .card__blurb {
    color: var(--color-ink-muted);
  }

</style>

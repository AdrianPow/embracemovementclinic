---
// Address, directions, hours and a static street map. Used on Home (compact) and Contact,
// which also shows parking (phone and email are in Contact's own cards above it). TODO: add a front-of-clinic photo here once supplied.
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import mapImage from '../assets/maps/clinic-map.png';
import Button from './Button.astro';
import Todo from './Todo.astro';
import { site } from '../data/site';

interface Props {
  /** Heading level for the section title. */
  as?: 'h1' | 'h2';
  eyebrow?: string;
  title?: string;
  /** Home page version: address, directions, hours and a map. Contact adds parking. */
  compact?: boolean;
}

const { as: Heading = 'h2', eyebrow, title = 'Find the clinic', compact = false } = Astro.props;
const { address, hours, notice } = site;
---

<section class="section section--alt location" aria-labelledby="location-h">
  <div class="wrap location__grid">
    <div class="location__info flow" style="--flow-space: var(--space-m)">
      <div class="flow" style="--flow-space: var(--space-xs)">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <Heading id="location-h" class="h2 badged"><span class="hbadge" aria-hidden="true"><Icon name="map-pin" size={24} /></span>{title}</Heading>
      </div>

      <address class="location__address">
        {site.name}<br />
        {address.street}<br />
        {`${address.suburb} ${address.state} ${address.postcode}`}
      </address>

      <div class="location__actions">
        <Button href={address.directionsUrl} icon="map-pin">Get directions</Button>
        {!compact && <Button href={address.mapUrl} variant="secondary">Open in Google Maps</Button>}
      </div>

      <ul class="location__cards" role="list">
        {
          !compact && (
            <>
              <li class="loc-card">
                <span class="loc-card__icon"><Icon name="info" size={20} /></span>
                <div>
                  <h3 class="loc-card__title">Parking</h3>
                  <p>{site.parking ?? <Todo>parking details</Todo>}</p>
                </div>
              </li>
            </>
          )
        }
        <li class="loc-card">
          <span class="loc-card__icon"><Icon name="clock" size={20} /></span>
          <div>
            <h3 class="loc-card__title">Hours</h3>
            {
              hours ? (
                <dl class="hours">
                  {hours.map((h) => (
                    <div>
                      <dt>{h.days}</dt>
                      <dd>{h.hours}</dd>
                    </div>
                  ))}
                </dl>
              ) : (
                <Todo>opening hours</Todo>
              )
            }
            {notice.enabled && <p class="location__note">{notice.message}</p>}
          </div>
        </li>
      </ul>
      {
        compact && (
          <a class="location__more" href="/contact">
            Parking, phone and email <Icon name="arrow-right" size={16} />
          </a>
        )
      }
    </div>

    <figure class="location__map">
      <a href={address.mapUrl}>
        <Photo
          src={mapImage}
          alt={`Map showing the clinic at ${address.street}, ${address.suburb}. Opens Google Maps`}
          ratio="4 / 5"
          widths={[400, 600, 800, 1200]}
          sizes="(min-width: 56em) 40vw, 100vw"
        />
      </a>
      <figcaption>
        Map data ©{' '}
        <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .location__grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  @media (min-width: 56em) {
    .location__grid {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-xl);
    }
  }

  .location__address {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-style: normal;
    font-weight: 600;
    line-height: 1.45;
  }

  .location__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  /* Parking and hours as white cards with an icon, as on Patient information. */
  .location__cards {
    display: grid;
    gap: var(--space-s);
  }

  .loc-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-s);
    padding: var(--space-m);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    background: var(--color-bg);
  }

  .loc-card__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-accent-soft);
    color: var(--color-icon);
  }

  .loc-card__title {
    margin-bottom: var(--space-3xs);
    font-size: var(--step-0);
  }

  /* Hours: day on the left, times on the right. */
  .hours div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: 0.3rem;
    border-top: 1px solid var(--color-line);
  }

  .hours div:first-child {
    border-top: 0;
  }

  .hours dt {
    font-weight: 600;
  }

  .hours dd {
    margin: 0;
    text-align: right;
  }

  .location__note {
    margin-top: var(--space-2xs);
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .location__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-family: var(--font-display);
    font-weight: 650;
  }

  .location__map {
    margin: 0;
  }

  .location__map > a {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-l);
  }

  .location__map :global(.photo) {
    max-height: 32rem;
  }

  @media (max-width: 55.99em) {
    .location__map :global(.photo) {
      aspect-ratio: 4 / 3 !important;
    }
  }

  .location__map figcaption {
    margin-top: var(--space-2xs);
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }
</style>

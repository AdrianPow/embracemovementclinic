---
// Address, directions, contact details, parking and hours. Used on Home (compact: address,
// directions, hours and the static map) and Contact (everything).
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import mapImage from '../assets/maps/clinic-map.png';
import Button from './Button.astro';
import Todo from './Todo.astro';
import { site } from '../data/site';

interface Props {
  /** Heading level for the section title. */
  as?: 'h1' | 'h2';
  eyebrow?: string;
  title?: string;
  /** Home page version: address, directions, hours and a map. Contact shows everything. */
  compact?: boolean;
}

const { as: Heading = 'h2', eyebrow = 'Visit us', title = 'Find the clinic', compact = false } = Astro.props;
const { address, phone, email, hours, notice } = site;
---

<section class="section section--alt location" aria-labelledby="location-h">
  <div class="wrap location__grid">
    <div class="location__info flow" style="--flow-space: var(--space-m)">
      <div class="flow" style="--flow-space: var(--space-xs)">
        <p class="eyebrow">{eyebrow}</p>
        <Heading id="location-h" class="h2">{title}</Heading>
      </div>

      <address class="location__address">
        {site.name}<br />
        {address.street}<br />
        {`${address.suburb} ${address.state} ${address.postcode}`}
      </address>

      <div class="location__actions">
        <Button href={address.directionsUrl} icon="map-pin">Get directions</Button>
        {!compact && <Button href={address.mapUrl} variant="secondary">Open in Google Maps</Button>}
      </div>

      <dl class="location__details">
        {
          !compact && (
            <>
              <div>
                <dt>Phone</dt>
                <dd>
                  <a href={phone.href}>{phone.display}</a>
                </dd>
              </div>
              <div>
                <dt>Email</dt>
                <dd>
                  <a href={email.href}>{email.address}</a>
                </dd>
              </div>
              <div>
                <dt>Parking</dt>
                <dd>
                  <Todo>parking details</Todo>
                </dd>
              </div>
            </>
          )
        }
        <div>
          <dt>Hours</dt>
          <dd>
            {
              hours ? (
                <ul role="list">
                  {hours.map((h) => (
                    <li>
                      {h.days}: {h.hours}
                    </li>
                  ))}
                </ul>
              ) : (
                <Todo>opening hours</Todo>
              )
            }
            {notice.enabled && <p class="location__note">{notice.message}</p>}
          </dd>
        </div>
      </dl>
      {
        compact && (
          <a class="location__more" href="/contact">
            Parking, phone and email <Icon name="arrow-right" size={16} />
          </a>
        )
      }
    </div>

    {
      compact ? (
        <figure class="location__map">
          <a href={address.mapUrl}>
            <Photo
              src={mapImage}
              alt={`Map showing the clinic at ${address.street}, ${address.suburb}. Opens Google Maps`}
              ratio="4 / 5"
              widths={[400, 600, 800, 1200]}
              sizes="(min-width: 56em) 40vw, 100vw"
            />
          </a>
          <figcaption>
            Map data ©{' '}
            <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>
          </figcaption>
        </figure>
      ) : (
        <Photo
          alt="The front of Embrace Movement Clinic"
          note="PXL_20220610_233809257-2.jpg from the current Contact page"
          ratio="4 / 5"
          class="location__photo"
          sizes="(min-width: 62em) 40vw, 100vw"
        />
      )
    }
  </div>
</section>

<style>
  .location__grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  @media (min-width: 56em) {
    .location__grid {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-xl);
    }
  }

  .location__address {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-style: normal;
    font-weight: 600;
    line-height: 1.45;
  }

  .location__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .location__details {
    display: grid;
    gap: var(--space-s);
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-line);
  }

  .location__details div {
    display: grid;
    gap: var(--space-3xs);
  }

  @media (min-width: 30em) {
    .location__details div {
      grid-template-columns: 6rem 1fr;
      gap: var(--space-s);
    }
  }

  .location__details dt {
    font-family: var(--font-display);
    font-weight: 650;
  }

  .location__details dd {
    margin: 0;
  }

  .location__details a {
    overflow-wrap: anywhere;
  }

  .location__note {
    margin-top: var(--space-2xs);
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  :global(.location__photo) {
    border-radius: var(--radius-l);
    max-height: 36rem;
  }

  .location__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-family: var(--font-display);
    font-weight: 650;
  }

  .location__map {
    margin: 0;
  }

  .location__map > a {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-l);
  }

  .location__map :global(.photo) {
    max-height: 32rem;
  }

  @media (max-width: 55.99em) {
    .location__map :global(.photo) {
      aspect-ratio: 4 / 3 !important;
    }
  }

  .location__map figcaption {
    margin-top: var(--space-2xs);
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }
</style>

---
import '../styles/global.css';
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NoticeBanner from '../components/NoticeBanner.astro';
import { site } from '../data/site';

interface Props {
  /** Page name; " | Embrace Movement Clinic" is appended unless this is the home page. */
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, imageAlt, noindex = false, jsonLd } = Astro.props;

const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/(.)\/$/, '$1');
const canonical = new URL(path, site.url).href;

// Pages can pass their own share image; otherwise the wordmark card in public/og-default.png is used.
const og = image ? await getImage({ src: image, format: 'jpg', width: Math.min(1200, image.width) }) : null;
const ogUrl = new URL(og ? og.src : '/og-default.png', site.url).href;
const ogAlt = image ? imageAlt : `${site.name}: Accept . Support . Challenge .`;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    {ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-red-hat-text" preload />
    <Font cssVariable="--font-red-hat-display" preload />
    <slot name="head" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <NoticeBanner />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>

---
import '../styles/global.css';
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NoticeBanner from '../components/NoticeBanner.astro';
import { site } from '../data/site';
import PreviewBar from '../components/PreviewBar.astro';
import { themeCss, previewIds } from '../data/palette';

interface Props {
  /** Page name; " | Embrace Movement Clinic" is appended unless it already contains the clinic name. */
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** The photo's focus point ("x% y%"), so the landscape share crop keeps faces in view. */
  imagePosition?: string;
  /** A ready-made 1200×630 share image in public/ (e.g. the practitioner cards from scripts/make-share-images.mjs). */
  shareImage?: string;
  /** "article" for news posts. */
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, imageAlt, imagePosition, shareImage, ogType = 'website', noindex = false, jsonLd } = Astro.props;

// Search results show about 60 characters, so long titles go without the clinic name.
const withName = `${title} | ${site.name}`;
const pageTitle = title.includes(site.name) || withName.length > 65 ? title : withName;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/(.)\/$/, '$1');
const canonical = new URL(path, site.url).href;

// Pages can pass their own share image; otherwise the wordmark card in public/og-default.png is used.
// Share images are cropped to 1200×630, the shape Facebook, LinkedIn and messaging apps show.
const gravity = (pos = '50% 50%') => {
  const [x = 50, y = 50] = pos.split(/\s+/).map((v) => Number.parseFloat(v));
  const v = y <= 33 ? 'top' : y >= 67 ? 'bottom' : '';
  const h = x <= 33 ? 'left' : x >= 67 ? 'right' : '';
  return [h, v].filter(Boolean).join(' ') || 'centre';
};
const og = image
  ? await getImage({ src: image, format: 'jpg', width: 1200, height: 630, fit: 'cover', position: gravity(imagePosition) })
  : null;
const ogUrl = new URL(shareImage ?? (og ? og.src : '/og-default.png'), site.url).href;
const ogAlt = shareImage || image ? imageAlt : `${site.name}: Accept . Support . Challenge .`;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-red-hat-text" preload />
    <Font cssVariable="--font-red-hat-display" preload />
    <slot name="head" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <style is:global set:html={themeCss()}></style>
    <!-- Palette preview, for trying other colours from /palette: ?palette=navy-teal, or ?palette=off -->
    <script is:inline define:vars={{ ids: previewIds }}>
      (function () {
        var d = document.documentElement;
        var q = new URLSearchParams(location.search).get('palette');
        var v = null;
        try {
          if (q === 'off') localStorage.removeItem('palette-preview');
          else if (q && ids.indexOf(q) > -1) localStorage.setItem('palette-preview', q);
          v = localStorage.getItem('palette-preview');
        } catch (e) {
          v = q;
        }
        if (v && ids.indexOf(v) > -1) {
          var p = v.split('-');
          d.dataset.dark = p[0];
          d.dataset.accent = p[1];
          d.dataset.preview = v;
        }
      })();
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <NoticeBanner />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <PreviewBar />
    <script is:inline>
      // Closure notes repeat the notice banner; like the banner, they go once its end date has passed
      // (Brisbane time), even before the site is next rebuilt.
      // Nookal links typed into posts or bios, and every page link inside a news post (e.g. the
      // timetable), open in a new tab, so readers keep their place. Phone, text and email links don't.
      document.querySelectorAll('a[href*=".nookal.com/"]:not([target]), .post-body a[href^="/"]:not([target])').forEach(function (a) {
        a.target = '_blank';
        a.rel = 'noopener';
        var s = document.createElement('span');
        s.className = 'visually-hidden';
        s.textContent = ' (opens in a new tab)';
        a.appendChild(s);
      });
      document.querySelectorAll('[data-hide-after]').forEach(function (el) {
        var d = el.getAttribute('data-hide-after');
        if (d && new Date() > new Date(d + 'T23:59:59+10:00')) el.remove();
      });
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>

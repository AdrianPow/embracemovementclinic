---
// Style tile for owner sign-off. Not indexed, not in the sitemap.
// Palette options are defined in src/styles/tokens.css; switch with the buttons or ?palette=<id>.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Todo from '../components/Todo.astro';
import Icon from '../components/Icon.astro';
import Wordmark from '../components/Wordmark.astro';
import { site } from '../data/site';

const luminance = (hex: string) => {
  const [r, g, b] = [1, 3, 5].map((i) => {
    const c = parseInt(hex.slice(i, i + 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const contrast = (a: string, b: string) => {
  const [hi, lo] = [luminance(a), luminance(b)].sort((x, y) => y - x);
  return (hi + 0.05) / (lo + 0.05);
};

// Mirrors tokens.css; used for the swatches and the contrast checks.
const palettes = [
  {
    id: 'forest',
    name: 'Forest',
    mood: 'Calm and premium. White on deep green, warm bone and a soft sage accent. Dark header.',
    c: { brand: '#1E3A2F', alt: '#F5F3EE', ink: '#161A18', muted: '#545B57', accent: '#B9CBB0', accentOnBrand: '#B9CBB0', soft: '#EEF2EA', link: '#1E3A2F', btn: '#1E3A2F', btnInk: '#FFFFFF', btnDark: '#B9CBB0', btnDarkInk: '#161A18' },
  },
  {
    id: 'pine',
    name: 'Pine & Lime',
    mood: 'Modern and energetic. Deep pine with an electric lime accent, a nod to movement and sport.',
    c: { brand: '#0E2A21', alt: '#F2F4EF', ink: '#0F1412', muted: '#4F5753', accent: '#C8F062', accentOnBrand: '#C8F062', soft: '#F1FBD9', link: '#0E2A21', btn: '#C8F062', btnInk: '#0E2A21', btnDark: '#C8F062', btnDarkInk: '#0E2A21' },
  },
  {
    id: 'mono',
    name: 'Monochrome',
    mood: 'Minimal and gallery-like. Near-black and white with a hint of sage; lets the photography lead.',
    c: { brand: '#111312', alt: '#F3F4F1', ink: '#111312', muted: '#565C58', accent: '#A7B8A0', accentOnBrand: '#A7B8A0', soft: '#EEF1EC', link: '#111312', btn: '#111312', btnInk: '#FFFFFF', btnDark: '#FFFFFF', btnDarkInk: '#111312' },
  },
  {
    id: 'clay',
    name: 'Charcoal & Clay',
    mood: 'Warm boutique, no green. Charcoal, sand and terracotta; feels like a studio.',
    c: { brand: '#24211F', alt: '#F4EEE7', ink: '#1D1B19', muted: '#5E5750', accent: '#A4532F', accentOnBrand: '#E09A78', soft: '#F6E8DF', link: '#8A4426', btn: '#A4532F', btnInk: '#FFFFFF', btnDark: '#A4532F', btnDarkInk: '#FFFFFF' },
  },
  {
    id: 'navy',
    name: 'Navy & Sand',
    mood: 'Coastal and calm. Deep navy, sand and a soft coral accent; clinical but warm.',
    c: { brand: '#16253D', alt: '#F2ECE3', ink: '#141B26', muted: '#535B66', accent: '#E39A7A', accentOnBrand: '#E39A7A', soft: '#FAEAE2', link: '#16253D', btn: '#16253D', btnInk: '#FFFFFF', btnDark: '#E39A7A', btnDarkInk: '#141B26' },
  },
].map((p) => {
  const c = p.c;
  const checks = [
    ['Body text on white', c.ink, '#FFFFFF'],
    ['Secondary text on sand/alt', c.muted, c.alt],
    ['Links on white', c.link, '#FFFFFF'],
    ['Notice banner text', c.ink, c.soft],
    ['White text on brand', '#FFFFFF', c.brand],
    ['Accent text on brand', c.accentOnBrand, c.brand],
    ['Button on light', c.btnInk, c.btn],
    ['Button on brand', c.btnDarkInk, c.btnDark],
  ].map(([label, fg, bg]) => ({ label, fg, bg, ratio: contrast(fg, bg) }));
  return {
    ...p,
    checks,
    min: Math.min(...checks.map((x) => x.ratio)),
    swatches: [
      ['Brand', c.brand],
      ['Accent', c.accent],
      ['Sand / alt', c.alt],
      ['Ink', c.ink],
      ['White', '#FFFFFF'],
    ],
  };
});

const grade = (r: number) => (r >= 7 ? 'AAA' : r >= 4.5 ? 'AA' : 'Fail');
---

<BaseLayout
  title="Style tile"
  description="Palette, type and components for the Embrace Movement Clinic website. For owner sign-off."
  noindex
>
  <script is:inline slot="head">
    (function () {
      var p = new URLSearchParams(location.search).get('palette');
      if (p && /^[a-z]+$/.test(p)) document.documentElement.dataset.palette = p;
    })();
  </script>

  <section class="section sg-intro">
    <div class="wrap flow" style="--flow-space: var(--space-s)">
      <p class="eyebrow">Design direction · For sign-off</p>
      <h1>Palette options</h1>
      <p class="lede prose">
        Five directions, all using the plain wordmark and Red Hat type. Each one passes WCAG&nbsp;2.2&nbsp;AA for every
        text pairing. Choose one below to re-colour this whole page, including the real header and footer.
      </p>
      <div class="switcher" role="group" aria-label="Preview palette">
        {
          palettes.map((p) => (
            <button type="button" class="switcher__btn" data-set-palette={p.id} aria-pressed={p.id === site.palette ? 'true' : 'false'}>
              <span class="switcher__dot" style={`background:${p.c.brand};box-shadow: inset 0 0 0 3px ${p.c.accent}`} />
              {p.name}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- At-a-glance comparison: each card is scoped to its own palette. -->
  <section class="section section--tight" aria-labelledby="overview-h" id="overview">
    <div class="wrap flow" style="--flow-space: var(--space-m)">
      <h2 id="overview-h" class="h3">At a glance</h2>
      <ul class="overview" role="list">
        {
          palettes.map((p, i) => (
            <li class="ov" data-palette={p.id}>
              <div class="ov__mock" aria-hidden="true">
                <div class="ov__header">
                  <span class="ov__logo">
                    <Wordmark />
                  </span>
                  <span class="ov__nav">Services · Classes · Team</span>
                  <span class="ov__btn ov__btn--header">Book now</span>
                </div>
                <div class="ov__hero on-brand">
                  <span class="ov__eyebrow">Physiotherapy · Pilates</span>
                  <span class="ov__title">{site.tagline}</span>
                  <span class="ov__btn">Book now</span>
                </div>
                <div class="ov__strip">
                  <span class="ov__card">
                    <span class="ov__card-title">Exercise Physiology</span>
                    <span class="ov__card-link">Learn more →</span>
                  </span>
                  <span class="ov__card">
                    <span class="ov__card-title">Pelvic Floor Physio</span>
                    <span class="ov__card-link">Learn more →</span>
                  </span>
                </div>
              </div>
              <div class="ov__body">
                <h3 class="ov__name">
                  {i + 1}. {p.name}
                </h3>
                <p class="ov__mood">{p.mood}</p>
                <ul class="ov__swatches" role="list">
                  {p.swatches.map(([label, hex]) => (
                    <li>
                      <span class="ov__chip" style={`background:${hex}`} />
                      <span>
                        {label}
                        <code>{hex}</code>
                      </span>
                    </li>
                  ))}
                </ul>
                <p class="ov__aa">Lowest text contrast {p.min.toFixed(1)}:1 (AA needs 4.5)</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Live preview: follows the palette chosen above. -->
  <div id="preview">
    <section class="on-brand hero" aria-labelledby="hero-h">
      <div class="wrap hero__grid">
        <div class="hero__text flow" style="--flow-space: var(--space-m)">
          <p class="eyebrow">Physiotherapy · Exercise physiology · Clinical pilates</p>
          <h2 id="hero-h" class="h1">{site.tagline}</h2>
          <p class="lede">At Embrace we believe the journey of one’s health is as important as the destination.</p>
          <div class="cluster">
            <Button href="/book-now" icon="calendar" size="l">Book now</Button>
            <Button href="/services" variant="secondary" size="l">Our services</Button>
          </div>
        </div>
        <div class="photo-ph photo-ph--hero" role="img" aria-label="Photo placeholder">
          <Todo>photo</Todo>
        </div>
      </div>
    </section>

    <section class="section section--alt" aria-labelledby="svc-h">
      <div class="wrap flow" style="--flow-space: var(--space-l)">
        <div class="flow" style="--flow-space: var(--space-xs)">
          <p class="eyebrow">Services</p>
          <h2 id="svc-h">We embrace everyone in their health journey</h2>
        </div>
        <ul class="cards" role="list">
          <li>
            <a class="card" href="/physiotherapy">
              <div class="photo-ph" role="img" aria-label="Photo placeholder"><Todo>photo</Todo></div>
              <div class="card__body">
                <h3 class="h4">Musculoskeletal Physiotherapy</h3>
                <p>Sporting injuries, back and neck pain, joint pain, chronic pain and post-surgical care.</p>
                <span class="card__more">Learn more <Icon name="arrow-right" size={16} /></span>
              </div>
            </a>
          </li>
          <li>
            <a class="card" href="/exercise-physiology">
              <div class="photo-ph" role="img" aria-label="Photo placeholder"><Todo>photo</Todo></div>
              <div class="card__body">
                <h3 class="h4">Exercise Physiology</h3>
                <p>Injury rehabilitation and prevention, chronic disease management, healthy ageing and athletic performance.</p>
                <span class="card__more">Learn more <Icon name="arrow-right" size={16} /></span>
              </div>
            </a>
          </li>
          <li>
            <a class="card" href="/pilates">
              <div class="photo-ph" role="img" aria-label="Photo placeholder"><Todo>photo</Todo></div>
              <div class="card__body">
                <h3 class="h4">Pilates &amp; Small Group Classes</h3>
                <p>Small group classes on the Reformer, Wunda Chair, Trapeze Table and CoreAlign.</p>
                <span class="card__more">Learn more <Icon name="arrow-right" size={16} /></span>
              </div>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="expect-h">
      <div class="wrap split">
        <div class="flow" style="--flow-space: var(--space-s)">
          <p class="eyebrow">Exercise Physiology</p>
          <h2 id="expect-h" class="h3">What to expect</h2>
        </div>
        <div class="prose">
          <p>
            During your initial consultation, we will take the time to understand your medical history, current fitness level,
            and specific health concerns. A detailed physical assessment will follow to evaluate your movement patterns,
            strength, and flexibility. This thorough approach ensures that we develop a safe and effective exercise plan just
            for you.
          </p>
          <p><a href="/exercise-physiology">Read about Exercise Physiology</a></p>
        </div>
      </div>
    </section>

    <section class="section section--tight" aria-labelledby="aa-h">
      <div class="wrap flow" style="--flow-space: var(--space-m)">
        <h2 id="aa-h" class="h3">Contrast checks for this palette</h2>
        {
          palettes.map((p) => (
            <ul class="pairs" role="list" data-for={p.id} hidden={p.id !== site.palette}>
              {p.checks.map((x) => (
                <li class="pair">
                  <svg class="pair__sample" viewBox="0 0 56 48" aria-hidden="true" style={`background:${x.bg}`}>
                    <text x="28" y="31" text-anchor="middle" fill={x.fg} font-size="20" font-weight="650">
                      Aa
                    </text>
                  </svg>
                  <span class="pair__label">{x.label}</span>
                  <span class="pair__grade">
                    {x.ratio.toFixed(2)}:1 · {grade(x.ratio)}
                  </span>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </section>

    <section class="section section--alt" aria-labelledby="type-h">
      <div class="wrap flow" style="--flow-space: var(--space-m)">
        <h2 id="type-h" class="h3">Type: Red Hat Display + Red Hat Text</h2>
        <div class="type-scale">
          <p class="h1">{site.tagline}</p>
          <p class="h2">Pilates &amp; Small Group Classes</p>
          <p class="h3">Conditions we commonly treat</p>
          <p class="h4">Treatment may include</p>
          <p class="prose">
            Vestibular physiotherapy is a specialised form of physiotherapy aimed at treating disorders of the inner ear which
            play a crucial role in balance, spatial orientation, and coordination.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="comp-h">
      <div class="wrap flow" style="--flow-space: var(--space-m)">
        <h2 id="comp-h" class="h3">Wordmark and components</h2>
        <div class="marks">
          <div class="mark">
            <Wordmark />
          </div>
          <div class="mark on-brand">
            <Wordmark />
          </div>
        </div>
        <div class="cluster">
          <Button href="/book-now" icon="calendar">Book now</Button>
          <Button href="/services" variant="secondary">Our services</Button>
          <a href="/contact">Text link to Contact</a>
          <span>Missing facts show like this: <Todo>opening hours</Todo></span>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-set-palette]');
  const tables = document.querySelectorAll<HTMLElement>('[data-for]');

  const apply = (id: string) => {
    root.dataset.palette = id;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setPalette === id)));
    tables.forEach((t) => (t.hidden = t.dataset.for !== id));
  };

  apply(root.dataset.palette ?? 'forest');

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const id = b.dataset.setPalette ?? 'forest';
      apply(id);
      const url = new URL(location.href);
      url.searchParams.set('palette', id);
      history.replaceState(null, '', url);
    }),
  );
</script>

<style>
  .section--tight {
    padding-block: var(--space-l);
  }

  .cluster {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
  }

  /* Switcher */
  .switcher {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    padding-top: var(--space-xs);
  }

  .switcher__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 2.75rem;
    padding: 0.5em 1.1em 0.5em 0.6em;
    border: 1.5px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 600;
  }

  .switcher__btn[aria-pressed='true'] {
    border-color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }

  .switcher__dot {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
  }

  /* Overview cards */
  .overview {
    display: grid;
    gap: var(--space-m);
    padding: 0;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
  }

  .ov {
    display: grid;
    align-content: start;
    overflow: hidden;
    background: var(--color-bg);
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
  }

  .ov__mock {
    display: grid;
    font-family: var(--font-display);
    border-bottom: 1px solid var(--color-line);
  }

  .ov__header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.9rem;
    background: var(--header-bg);
    color: var(--header-ink);
    border-bottom: 1px solid var(--header-line);
  }

  .ov__logo {
    width: 4.5rem;
    margin-right: auto;
  }

  .ov__nav {
    font-size: 0.6875rem;
    font-weight: 550;
  }

  .ov__btn {
    display: inline-block;
    justify-self: start;
    padding: 0.35em 0.9em;
    border-radius: var(--radius-pill);
    background: var(--btn-bg);
    color: var(--btn-ink);
    font-size: 0.75rem;
    font-weight: 650;
  }

  .ov__btn--header {
    background: var(--header-btn-bg);
    color: var(--header-btn-ink);
    font-size: 0.6875rem;
  }

  .ov__hero {
    display: grid;
    gap: 0.55rem;
    padding: 1.4rem 0.9rem 1.5rem;
  }

  .ov__eyebrow {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-on-brand);
  }

  .ov__title {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .ov__strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    padding: 0.8rem 0.9rem;
    background: var(--color-bg-alt);
  }

  .ov__card {
    display: grid;
    gap: 0.25rem;
    padding: 0.6rem 0.7rem;
    background: var(--color-bg);
    border-radius: var(--radius-s);
  }

  .ov__card-title {
    font-size: 0.75rem;
    font-weight: 650;
  }

  .ov__card-link {
    font-size: 0.6875rem;
    font-weight: 650;
    color: var(--color-link);
  }

  .ov__body {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-m);
  }

  .ov__name {
    font-size: var(--step-1);
  }

  .ov__mood {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .ov__swatches {
    display: grid;
    gap: 0.35rem;
    padding: var(--space-2xs) 0 0;
    font-size: 0.8125rem;
  }

  .ov__swatches li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ov__swatches code {
    margin-left: 0.35rem;
    color: var(--color-ink-muted);
  }

  .ov__chip {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
  }

  .ov__aa {
    font-size: 0.8125rem;
    font-weight: 600;
  }

  /* Live preview */
  .hero {
    padding-block: clamp(3rem, 2rem + 5vw, 6.5rem);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  @media (min-width: 56em) {
    .hero__grid {
      grid-template-columns: 1.15fr 1fr;
    }
  }

  .photo-ph {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, var(--color-accent-soft), var(--color-bg-alt));
  }

  .photo-ph--hero {
    aspect-ratio: 4 / 5;
    max-height: 32rem;
    border-radius: var(--radius-l);
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--color-brand) 70%, #fff),
      color-mix(in srgb, var(--color-brand) 88%, #fff)
    );
  }

  .cards {
    display: grid;
    gap: var(--space-m);
    padding: 0;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }

  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    background: var(--color-bg);
    border-radius: var(--radius-l);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      box-shadow 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .card:hover {
    box-shadow: var(--shadow-m);
    transform: translateY(-2px);
  }

  .card__body {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding: var(--space-m);
  }

  .card__body p {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-top: var(--space-2xs);
    color: var(--color-link);
    font-family: var(--font-display);
    font-weight: 650;
  }

  .split {
    display: grid;
    gap: var(--space-m);
  }

  @media (min-width: 56em) {
    .split {
      grid-template-columns: 1fr 2fr;
    }
  }

  .pairs {
    display: grid;
    gap: var(--space-2xs);
    padding: 0;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }

  .pairs[hidden] {
    display: none;
  }

  .pair {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-2xs);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    font-size: var(--step--1);
  }

  .pair__sample {
    width: 100%;
    height: 3rem;
    border-radius: var(--radius-s);
    font-family: var(--font-body);
  }

  .pair__grade {
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  .type-scale {
    display: grid;
    gap: var(--space-s);
  }

  .marks {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .mark {
    display: grid;
    place-items: center;
    padding: var(--space-xl) var(--space-l);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
  }

  .mark :global(.wordmark) {
    width: min(100%, 15rem);
  }
</style>

---
// Style tile: the chosen design system (Forest palette, white header, Red Hat type).
// Not indexed and not in the sitemap. Colours mirror src/styles/tokens.css.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Todo from '../components/Todo.astro';
import Icon from '../components/Icon.astro';
import Wordmark from '../components/Wordmark.astro';
import { site } from '../data/site';

const luminance = (hex: string) => {
  const [r, g, b] = [1, 3, 5].map((i) => {
    const c = parseInt(hex.slice(i, i + 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const contrast = (a: string, b: string) => {
  const [hi, lo] = [luminance(a), luminance(b)].sort((x, y) => y - x);
  return (hi + 0.05) / (lo + 0.05);
};

const c = {
  brand: '#1E3A2F',
  brandDeep: '#142A21',
  accent: '#B9CBB0',
  soft: '#EEF2EA',
  alt: '#F5F3EE',
  line: '#E2DFD7',
  ink: '#161A18',
  muted: '#545B57',
  white: '#FFFFFF',
};

const swatches = [
  { name: 'Forest', hex: c.brand, use: 'Brand colour: footer, dark sections, primary buttons, links.' },
  { name: 'Forest deep', hex: c.brandDeep, use: 'Hover and pressed states on forest.' },
  { name: 'Sage', hex: c.accent, use: 'Accent: buttons and headings on forest, highlights.' },
  { name: 'Sage soft', hex: c.soft, use: 'Notice banner and soft highlights.' },
  { name: 'Bone', hex: c.alt, use: 'Alternate section background.' },
  { name: 'Line', hex: c.line, use: 'Borders and dividers (decorative).' },
  { name: 'Ink', hex: c.ink, use: 'Body text and headings.' },
  { name: 'Ink muted', hex: c.muted, use: 'Secondary text.' },
  { name: 'White', hex: c.white, use: 'Page and header background.' },
];

const checks = [
  ['Body text on white', c.ink, c.white],
  ['Body text on bone', c.ink, c.alt],
  ['Secondary text on bone', c.muted, c.alt],
  ['Links on white', c.brand, c.white],
  ['Notice banner text', c.ink, c.soft],
  ['Primary button (header and light sections)', c.white, c.brand],
  ['White text on forest', c.white, c.brand],
  ['Sage text on forest', c.accent, c.brand],
  ['Button on forest (ink on sage)', c.ink, c.accent],
].map(([label, fg, bg]) => ({ label, fg, bg, ratio: contrast(fg, bg) }));

const grade = (r: number) => (r >= 7 ? 'AAA' : r >= 4.5 ? 'AA' : 'Fail');
---

<BaseLayout
  title="Style tile"
  description="Palette, type and components for the Embrace Movement Clinic website."
  noindex
>
  <section class="section">
    <div class="wrap flow" style="--flow-space: var(--space-s)">
      <p class="eyebrow">Design system</p>
      <h1>Style tile</h1>
      <p class="lede prose">
        Forest palette with a white header, Red Hat Display and Red Hat Text, and the plain wordmark. Chosen by the owner on
        12&nbsp;October&nbsp;2026. Every text pairing passes WCAG&nbsp;2.2&nbsp;AA.
      </p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="colour-h">
    <div class="wrap flow" style="--flow-space: var(--space-m)">
      <h2 id="colour-h" class="h3">Colour</h2>
      <ul class="swatches" role="list">
        {
          swatches.map((s) => (
            <li class="swatch">
              <span class="swatch__chip" style={`background:${s.hex}`} />
              <span class="swatch__body">
                <strong>{s.name}</strong>
                <code>{s.hex}</code>
                <span class="swatch__use">{s.use}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <h3 class="h4">Contrast checks</h3>
      <ul class="pairs" role="list">
        {
          checks.map((x) => (
            <li class="pair">
              <svg class="pair__sample" viewBox="0 0 56 48" aria-hidden="true" style={`background:${x.bg}`}>
                <text x="28" y="31" text-anchor="middle" fill={x.fg} font-size="20" font-weight="650">
                  Aa
                </text>
              </svg>
              <span class="pair__label">{x.label}</span>
              <span class="pair__grade">
                {x.ratio.toFixed(2)}:1 · {grade(x.ratio)}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Preview of the main patterns -->
  <section class="on-brand hero" aria-labelledby="hero-h">
    <div class="wrap hero__grid">
      <div class="hero__text flow" style="--flow-space: var(--space-m)">
        <p class="eyebrow">Physiotherapy · Exercise physiology · Clinical pilates</p>
        <h2 id="hero-h" class="h1">{site.tagline}</h2>
        <p class="lede">At Embrace we believe the journey of one’s health is as important as the destination.</p>
        <div class="cluster">
          <Button href="/book-now" icon="calendar" size="l">Book now</Button>
          <Button href="/services" variant="secondary" size="l">Our services</Button>
        </div>
      </div>
      <div class="photo-ph photo-ph--hero" role="img" aria-label="Photo placeholder">
        <Todo>photo</Todo>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="svc-h">
    <div class="wrap flow" style="--flow-space: var(--space-l)">
      <div class="flow" style="--flow-space: var(--space-xs)">
        <p class="eyebrow">Card pattern</p>
        <h2 id="svc-h" class="h3">Service cards</h2>
      </div>
      <ul class="cards" role="list">
        <li>
          <a class="card" href="/physiotherapy">
            <div class="photo-ph" role="img" aria-label="Photo placeholder"><Todo>photo</Todo></div>
            <div class="card__body">
              <h3 class="h4">Musculoskeletal Physiotherapy</h3>
              <p>Sporting injuries, back and neck pain, joint pain, chronic pain and post-surgical care.</p>
              <span class="card__more">Learn more <Icon name="arrow-right" size={16} /></span>
            </div>
          </a>
        </li>
        <li>
          <a class="card" href="/pilates">
            <div class="photo-ph" role="img" aria-label="Photo placeholder"><Todo>photo</Todo></div>
            <div class="card__body">
              <h3 class="h4">Pilates &amp; Small Group Classes</h3>
              <p>Small group classes on the Reformer, Wunda Chair, Trapeze Table and CoreAlign.</p>
              <span class="card__more">Learn more <Icon name="arrow-right" size={16} /></span>
            </div>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="type-h">
    <div class="wrap flow" style="--flow-space: var(--space-m)">
      <h2 id="type-h" class="h3">Type: Red Hat Display + Red Hat Text</h2>
      <div class="type-scale">
        <p class="h1">{site.tagline}</p>
        <p class="h2">Pilates &amp; Small Group Classes</p>
        <p class="h3">Conditions we commonly treat</p>
        <p class="h4">Treatment may include</p>
        <p class="eyebrow">Eyebrow label</p>
        <p class="lede prose">At Embrace we believe the journey of one’s health is as important as the destination.</p>
        <p class="prose">
          Vestibular physiotherapy is a specialised form of physiotherapy aimed at treating disorders of the inner ear which play
          a crucial role in balance, spatial orientation, and coordination. <a href="/vestibular-physiotherapy">Text link</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="comp-h">
    <div class="wrap flow" style="--flow-space: var(--space-m)">
      <h2 id="comp-h" class="h3">Wordmark and components</h2>
      <div class="marks">
        <div class="mark">
          <Wordmark />
        </div>
        <div class="mark on-brand">
          <Wordmark />
        </div>
      </div>
      <div class="cluster">
        <Button href="/book-now" icon="calendar">Book now</Button>
        <Button href="/services" variant="secondary">Our services</Button>
        <a href="/contact">Text link</a>
        <span>Missing facts show like this: <Todo>opening hours</Todo></span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section--tight {
    padding-block: var(--space-l);
  }

  .cluster {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
  }

  .swatches {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
  }

  .swatch {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
  }

  .swatch__chip {
    height: 4.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .swatch__body {
    display: grid;
    align-content: start;
    gap: 0.2rem;
    padding: var(--space-xs) var(--space-s) var(--space-s);
    font-size: var(--step--1);
  }

  .swatch__use {
    color: var(--color-ink-muted);
  }

  .pairs {
    display: grid;
    gap: var(--space-2xs);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }

  .pair {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-2xs);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    font-size: var(--step--1);
  }

  .pair__sample {
    width: 100%;
    height: 3rem;
    border-radius: var(--radius-s);
    font-family: var(--font-body);
  }

  .pair__grade {
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  .hero {
    padding-block: clamp(3rem, 2rem + 5vw, 6.5rem);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  @media (min-width: 56em) {
    .hero__grid {
      grid-template-columns: 1.15fr 1fr;
    }
  }

  .photo-ph {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, var(--color-accent-soft), var(--color-bg-alt));
  }

  .photo-ph--hero {
    aspect-ratio: 4 / 5;
    max-height: 32rem;
    border-radius: var(--radius-l);
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--color-brand) 70%, #fff),
      color-mix(in srgb, var(--color-brand) 88%, #fff)
    );
  }

  .cards {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }

  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    background: var(--color-bg);
    border-radius: var(--radius-l);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      box-shadow 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .card:hover {
    box-shadow: var(--shadow-m);
    transform: translateY(-2px);
  }

  .card__body {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding: var(--space-m);
  }

  .card__body p {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-top: var(--space-2xs);
    color: var(--color-link);
    font-family: var(--font-display);
    font-weight: 650;
  }

  .type-scale {
    display: grid;
    gap: var(--space-s);
  }

  .marks {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .mark {
    display: grid;
    place-items: center;
    padding: var(--space-xl) var(--space-l);
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
  }

  .mark.on-brand {
    background: var(--color-brand);
  }

  .mark :global(.wordmark) {
    width: min(100%, 15rem);
  }
</style>

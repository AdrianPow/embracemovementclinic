---
// Pilates & small group classes. Merges the old /pilates and /group-exercise-timetable pages.
import { getEntry, getEntries, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import CancellationCallout from '../components/CancellationCallout.astro';
import StepStrip from '../components/StepStrip.astro';
import Todo from '../components/Todo.astro';
import PractitionerList from '../components/PractitionerList.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BookingBand from '../components/BookingBand.astro';
import ClosureNote from '../components/ClosureNote.astro';
import Timetable from '../components/Timetable.astro';
import { site, newTabAttrs } from '../data/site';
import { classFacts, classSteps, equipment, booking, bookingTip, timetable } from '../data/policies';

const service = (await getEntry('services', 'pilates')) as CollectionEntry<'services'>;
const d = service.data;
const related = (await getEntries(d.related)) as CollectionEntry<'services'>[];

---

<BaseLayout title={d.seoTitle} description={d.seoDescription} shareImage={d.image ? `/og/services/${service.id}.jpg` : undefined} imageAlt={d.imageAlt}>
  <PageHero
    tone="brand"
    curve={false}
    crumbs={[{ label: 'Services', href: '/services' }, { label: 'Pilates & classes' }]}
    title={d.title}
    lede={d.lede}
  >
    <Fragment slot="actions">
      <Button href={site.booking.url} icon="calendar" size="l">Book now</Button>
      <Button href="#timetable" variant="secondary" size="l" class="wide-only">Timetable</Button>
      <Button href={site.phone.href} variant="secondary" size="l" icon="phone" class="phone-only">Call {site.phone.display}</Button>
    </Fragment>
    <Photo slot="aside" src={d.image} alt={d.imageAlt ?? ''} note={d.imageNote} position={d.imagePosition} ratio="4 / 3" tone="dark" loading="eager" sizes="(min-width: 56em) 45vw, 100vw" />
  </PageHero>

  <section class="on-brand factbar curve-bottom" aria-label="Class details">
    <div class="wrap">
      <dl class="factbar__list">
        {
          classFacts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <nav class="onpage" aria-label="On this page">
    <div class="wrap">
      <ul role="list">
        <li><a href="#start">How to start</a></li>
        <li><a href="#for-you">Who it’s for</a></li>
        <li><a href="#timetable">Timetable</a></li>
        <li><a href="#studio">The studio</a></li>
        <li><a href="#cancellations">Cancellations</a></li>
        <li><a href="#who">Instructors</a></li>
      </ul>
    </div>
  </nav>

  <section class="section start" id="start" aria-labelledby="start-h">
    <div class="wrap">
      <StepStrip as="h2" id="start-h" title="How to start classes" steps={classSteps} />
      <p class="code-tip">
        <Icon name="info" size={20} />
        <span>{bookingTip.before}{bookingTip.link && <a href={bookingTip.link.href} {...newTabAttrs(bookingTip.link.href)}>{bookingTip.link.text}<span class="visually-hidden"> (opens in a new tab)</span></a>}{bookingTip.after}</span>
      </p>
    </div>
  </section>

  <section class="section section--alt" id="for-you" aria-labelledby="for-you-h">
    <div class="wrap two-col">
      <div class="head">
        <h2 id="for-you-h" class="badged"><span class="hbadge" aria-hidden="true"><Icon name="heart" size={24} /></span>{d.forYou.heading}</h2>
        <ul class="ticks" role="list">
          {
            d.forYou.items.map((i) => (
              <li>
                <Icon name="check" size={20} />
                {i.name}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="expect">
        <h3>What to expect</h3>
        <p>{d.expect.text}</p>
      </div>
    </div>
  </section>

  <section class="section" id="timetable" aria-labelledby="timetable-h">
    <div class="wrap">
      <div class="head head--wide">
        <h2 id="timetable-h" class="badged"><span class="hbadge" aria-hidden="true"><Icon name="calendar" size={24} /></span>Timetable</h2>
        <p class="head__intro">{booking.classes}</p>
      </div>
      <ClosureNote />
      {
        timetable ? (
          <Timetable days={timetable} />
        ) : (
          <Todo as="div">current class timetable as text (days and times, and who runs each class). The old timetable was an image from July 2025.</Todo>
        )
      }
      <div class="timetable__actions">
        <Button href={site.booking.url} icon="external">Check live availability</Button>
        <Button href={site.phone.href.replace('tel:', 'sms:')} variant="secondary" icon="message">
          Text us to join a waitlist
        </Button>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="studio" aria-labelledby="studio-h">
    <div class="wrap">
      <div class="head head--wide">
        <h2 id="studio-h" class="badged"><span class="hbadge" aria-hidden="true"><Icon name="dumbbell" size={24} /></span>Our clinic is equipped with</h2>
      </div>
      <ul class="kit">
        {equipment.map((e) => <li>{e}</li>)}
      </ul>
      <p class="kit__more">And much more.</p>
    </div>
  </section>

  <section class="section" id="cancellations" aria-labelledby="cancel-h">
    <div class="wrap">
      <div class="head head--wide">
        <h2 id="cancel-h" class="badged"><span class="hbadge" aria-hidden="true"><Icon name="clock" size={24} /></span>Cancellation policy</h2>
      </div>
      <CancellationCallout />
    </div>
  </section>

  <section class="section section--alt" id="who" aria-labelledby="who-h">
    <div class="wrap">
      <div class="head">
        <h2 id="who-h" class="badged"><span class="hbadge" aria-hidden="true"><Icon name="users" size={24} /></span>Who runs the classes</h2>
        {d.practitionersNote && <p class="head__intro">{d.practitionersNote}</p>}
      </div>
      <PractitionerList refs={d.practitioners} />
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section" aria-labelledby="related-h">
        <div class="wrap">
          <div class="head">
            <h2 id="related-h"><span class="nowrap">One-on-one</span> appointments</h2>
          </div>
          <ul class="related" role="list">
            {related.map((r) => (
              <li>
                <ServiceCard service={r} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <BookingBand title="Ready to start classes?" text="Book your once-off pre-class assessment online, or call us to talk it through." />
</BaseLayout>

<style>
  .factbar {
    padding-bottom: calc(var(--space-l) + var(--curve) * 0.75);
  }

  .factbar__list {
    display: grid;
    gap: var(--space-s) var(--space-m);
    padding-top: var(--space-m);
    border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  .factbar dt {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-on-brand);
  }

  .factbar dd {
    margin: var(--space-3xs) 0 0;
  }

  .onpage {
    position: sticky;
    top: var(--header-h);
    z-index: 20;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
  }

  .onpage ul {
    display: flex;
    gap: var(--space-2xs);
    overflow-x: auto;
    padding-block: var(--space-2xs);
    scrollbar-width: none;
  }

  .onpage a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0.95em;
    border-radius: var(--radius-pill);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .onpage a:hover {
    background: var(--color-bg-alt);
  }

  :global(html) {
    scroll-padding-top: calc(var(--header-h) + 4rem);
  }

  .head {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
    max-width: 46rem;
    margin-bottom: var(--space-l);
  }

  /* Timetable intro runs the full width, like the notice and table under it. */
  .head--wide {
    max-width: none;
  }

  .head__intro {
    color: var(--color-ink-muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .start {
    padding-block: var(--space-xl);
  }

  .code-tip {
    display: flex;
    gap: var(--space-xs);
    align-items: flex-start;
    margin-top: var(--space-s);
    padding: var(--space-m);
    border-radius: var(--radius-l);
    background: var(--color-bg-alt);
  }

  .code-tip :global(svg) {
    margin-top: 0.15em;
    color: var(--color-icon);
    flex-shrink: 0;
  }

  .two-col {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 56em) {
    .two-col {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }

    .two-col .head {
      margin-bottom: 0;
    }
  }

  .ticks {
    display: grid;
    gap: var(--space-xs);
    padding-top: var(--space-xs);
  }

  .ticks li {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-weight: 550;
  }

  .ticks :global(svg) {
    color: var(--color-icon);
  }

  /* Native markers sit on the first line of each item, even when it wraps. */
  .kit {
    display: grid;
    gap: var(--space-xs) var(--space-l);
    padding-top: var(--space-xs);
    padding-left: 1.1em;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    line-height: 1.35;
  }

  @media (min-width: 56em) {
    .kit {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .kit li {
    padding-left: 0.2em;
    font-weight: 550;
  }

  .kit li::marker {
    color: var(--color-accent);
  }

  .kit__more {
    margin-top: var(--space-s);
    color: var(--color-ink-muted);
  }

  @media (max-width: 24em) {
    .kit {
      grid-template-columns: 1fr;
    }
  }

  .expect {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    font-size: var(--step-1);
    line-height: 1.6;
  }

  :global(#timetable .closure) {
    margin-bottom: var(--space-m);
  }

  .timetable__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-m);
  }

  .related {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }
</style>

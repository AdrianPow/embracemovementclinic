---
// Home. Structure from docs/site-strategy.md: promise → what can we help with → two ways
// to work with us → how it works → team → studio → visit → book.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Photo from '../components/Photo.astro';
import TeamCard from '../components/TeamCard.astro';
import LocationSection from '../components/LocationSection.astro';
import NeedsFinder from '../components/NeedsFinder.astro';
import SectionHead from '../components/SectionHead.astro';
import Steps from '../components/Steps.astro';
import BookingBand from '../components/BookingBand.astro';
import Icon from '../components/Icon.astro';
import Todo from '../components/Todo.astro';
import { site } from '../data/site';
import { equipment, classFacts } from '../data/policies';
import heroPhoto from '../assets/photos/pxl-20220610-230251564-2.webp';
import appointmentsPhoto from '../assets/photos/3-sam-1300.webp';
import classesPhoto from '../assets/photos/pxl-20220610-231040021.webp';
import trapezePhoto from '../assets/photos/pxl-20220610-231913214.webp';
import treatmentPhoto from '../assets/photos/pxl-20220611-041127782.webp';
import pregnancyPhoto from '../assets/photos/pxl-20220611-044952545.webp';
import backPhoto from '../assets/photos/6-sam-1312.webp';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const appointments = services.filter((s) => s.data.kind === 'appointment');
const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);

const facts = [
  { icon: 'user', text: 'One-on-one physiotherapy and exercise physiology' },
  { icon: 'users', text: 'Small group pilates classes' },
  { icon: 'shield', text: 'Physiotherapists with women’s pelvic health training' },
  { icon: 'map-pin', text: '33 Brynner Street, McDowall' },
] as const;

const howItWorks = [
  {
    name: 'Start with an assessment',
    detail: 'New clients begin with an initial consultation and assessment. For classes, that’s a once-off pre-class assessment.',
  },
  {
    name: 'A plan tailored to you',
    detail: 'We take the time to understand your history, needs and goals, and tailor treatment and exercise to suit you.',
  },
  {
    name: 'Keep moving',
    detail: 'Continue with one-on-one appointments, a home or gym program, or small group classes in the studio.',
  },
];

const gallery = [
  { src: trapezePhoto, alt: 'A client holding a plank with their feet in the Trapeze Table straps', position: '60% 50%' },
  { src: treatmentPhoto, alt: 'A physiotherapist treating a patient lying on the treatment table', position: '50% 40%' },
  { src: pregnancyPhoto, alt: 'A pregnant client kneeling beside an exercise ball', position: '50% 45%' },
  { src: backPhoto, alt: 'A physiotherapist treating a patient’s lower back', position: '50% 70%' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['MedicalBusiness', 'Physiotherapy'],
  name: site.name,
  url: site.url,
  image: `${site.url}/og-default.png`,
  telephone: '+61 434 686 261',
  email: site.email.address,
  slogan: 'Accept . Support . Challenge .',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.suburb,
    addressRegion: site.address.state,
    postalCode: site.address.postcode,
    addressCountry: site.address.country,
  },
  // TODO: openingHoursSpecification and sameAs (socials) once supplied.
};
---

<BaseLayout
  title="Embrace Movement Clinic | Physiotherapy, Exercise Physiology & Pilates in McDowall"
  description="Physiotherapy, pelvic floor and vestibular physiotherapy, exercise physiology and small group clinical pilates at 33 Brynner Street, McDowall QLD."
  jsonLd={jsonLd}
>
  <!-- Hero: what, where, who for -->
  <section class="on-brand hero" aria-labelledby="hero-h">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="eyebrow">{site.tagline}</p>
        <h1 id="hero-h">Physiotherapy, exercise physiology and pilates in McDowall</h1>
        <p class="lede">
          We embrace everyone in their health journey, with one-on-one appointments and small group classes. At Embrace we
          believe the journey of one’s health is as important as the destination.
        </p>
        <div class="hero__actions">
          <Button href={site.booking.url} icon="calendar" size="l">Book now</Button>
          <Button href="#help" variant="secondary" size="l">What can we help with?</Button>
        </div>
      </div>
      <Photo
        src={heroPhoto}
        alt="A practitioner with Jeff, the clinic dog, at the Trapeze Table in the studio"
        ratio="4 / 5"
        tone="dark"
        loading="eager"
        class="hero__photo"
        sizes="(min-width: 56em) 45vw, 100vw"
      />
    </div>
    <div class="wrap">
      <ul class="facts" role="list">
        {
          facts.map((f) => (
            <li>
              <Icon name={f.icon} size={22} />
              <span>{f.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- What can we help with? -->
  <section class="section" id="help" aria-labelledby="help-h">
    <div class="wrap">
      <SectionHead
        id="help-h"
        eyebrow="Find the right care"
        title="What can we help with?"
        intro="Start with what you’re dealing with. Each one links to the services that can help."
        link={{ href: '/services', label: 'All services' }}
      />
      <NeedsFinder />
    </div>
  </section>

  <!-- Two ways to work with us -->
  <section class="section section--alt" aria-labelledby="ways-h">
    <div class="wrap">
      <SectionHead id="ways-h" eyebrow="Services" title="Two ways to work with us" />
      <div class="ways">
        <article class="way" aria-labelledby="way-1">
          <Photo src={appointmentsPhoto} alt="" position="50% 66%" ratio="3 / 2" sizes="(min-width: 56em) 50vw, 100vw" />
          <div class="way__body">
            <p class="eyebrow">One-on-one</p>
            <h3 id="way-1">Appointments</h3>
            <p class="way__intro">Assessment and treatment with a physiotherapist or exercise physiologist, built around your needs and goals.</p>
            <ul class="way__list" role="list">
              {
                appointments.map((s) => (
                  <li>
                    <a href={`/${s.id}`}>
                      <span class="way__name">{s.data.title}</span>
                      <Icon name="arrow-right" size={18} />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </article>
        <article class="way" aria-labelledby="way-2">
          <Photo src={classesPhoto} alt="" ratio="3 / 2" sizes="(min-width: 56em) 50vw, 100vw" />
          <div class="way__body">
            <p class="eyebrow">Small groups</p>
            <h3 id="way-2">Pilates &amp; classes</h3>
            <p class="way__intro">
              Clinical pilates and small group exercise on the Reformer, Wunda Chair, Trapeze Table and CoreAlign, for all ages and
              abilities.
            </p>
            <dl class="way__facts">
              {
                classFacts.slice(0, 3).map((f) => (
                  <div>
                    <dt>{f.label}</dt>
                    <dd>{f.value}</dd>
                  </div>
                ))
              }
            </dl>
            <div class="way__cta">
              <Button href="/pilates">Classes &amp; timetable</Button>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section" aria-labelledby="how-h">
    <div class="wrap">
      <SectionHead id="how-h" eyebrow="Getting started" title="How it works" link={{ href: '/patient-information', label: 'Patient information' }} />
      <Steps steps={howItWorks} />
    </div>
  </section>

  <!-- Team -->
  <section class="section section--alt" aria-labelledby="team-h">
    <div class="wrap">
      <SectionHead
        id="team-h"
        eyebrow="Our team"
        title="Who you’ll see"
        intro="Both of our physiotherapists are clinical pilates instructors with Women’s Pelvic Health Physiotherapy training (APA)."
        link={{ href: '/team', label: 'Meet the team' }}
      />
      <ul class="team-grid" role="list">
        {
          team.map((m) => (
            <li>
              <TeamCard member={m} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- The studio -->
  <section class="section studio" aria-labelledby="studio-h">
    <div class="wrap">
      <div class="studio__intro">
        <blockquote class="studio__quote">
          <p>At Embrace we believe the journey of one’s health is as important as the destination.</p>
        </blockquote>
        <div class="studio__text">
          <p class="eyebrow">The studio</p>
          <h2 id="studio-h" class="h3">Our studio and equipment</h2>
          <ul class="chips" role="list">
            {equipment.map((e) => <li>{e}</li>)}
          </ul>
        </div>
      </div>
      <ul class="gallery" role="list">
        {
          gallery.map((g) => (
            <li>
              <Photo src={g.src} alt={g.alt} position={g.position} ratio="1 / 1" sizes="(min-width: 56em) 25vw, 50vw" />
            </li>
          ))
        }
      </ul>
      <p class="studio__gram">
        {
          site.socials.instagram ? (
            <a href={site.socials.instagram}>
              <Icon name="instagram" size={18} /> Follow us on Instagram
            </a>
          ) : (
            <Todo>Instagram profile link</Todo>
          )
        }
      </p>
    </div>
  </section>

  <LocationSection />

  <BookingBand title="Book an appointment" text={`Book online, or call us on ${site.phone.display}. New to classes? Start with a pre-class assessment.`} />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) var(--space-l);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  .hero__text {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  .hero h1 {
    font-size: clamp(2.3rem, 1.4rem + 3.1vw, 3.9rem);
    line-height: 1.04;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  :global(.hero__photo) {
    border-radius: var(--radius-l);
    max-height: 34rem;
  }

  @media (max-width: 55.99em) {
    :global(.hero__photo) {
      aspect-ratio: 4 / 3 !important;
    }
  }

  @media (min-width: 56em) {
    .hero__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-xl);
    }
  }

  .facts {
    display: grid;
    gap: var(--space-s) var(--space-m);
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    font-size: var(--step--1);
  }

  .facts li {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .facts :global(svg) {
    color: var(--color-accent-on-brand);
  }

  /* Two ways */
  .ways {
    display: grid;
    gap: var(--space-m);
  }

  @media (min-width: 56em) {
    .ways {
      grid-template-columns: 1fr 1fr;
    }
  }

  .way {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    background: var(--color-bg);
    border-radius: var(--radius-l);
  }

  .way__body {
    display: grid;
    align-content: start;
    gap: var(--space-s);
    padding: var(--space-l) var(--space-m);
  }

  .way__intro {
    color: var(--color-ink-muted);
  }

  .way__list li + li {
    border-top: 1px solid var(--color-line);
  }

  .way__list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: 3.25rem;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
  }

  .way__list a:hover .way__name {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .way__facts {
    display: grid;
    gap: 0;
  }

  .way__facts div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-xs);
    border-top: 1px solid var(--color-line);
  }

  .way__facts dt {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .way__facts dd {
    margin: 0;
    color: var(--color-ink-muted);
    text-align: right;
  }

  .way__cta {
    padding-top: var(--space-2xs);
  }

  /* Team */
  .team-grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    max-width: 52rem;
  }

  /* Studio */
  .studio__intro {
    display: grid;
    gap: var(--space-l);
    margin-bottom: var(--space-l);
  }

  @media (min-width: 56em) {
    .studio__intro {
      grid-template-columns: 1.3fr 1fr;
      gap: var(--space-xl);
      align-items: end;
    }
  }

  .studio__quote p {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .studio__quote p::before {
    content: '“';
    color: var(--color-accent);
  }

  .studio__quote p::after {
    content: '”';
    color: var(--color-accent);
  }

  .studio__text {
    display: grid;
    gap: var(--space-xs);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    padding-top: var(--space-2xs);
  }

  .chips li {
    padding: 0.35em 0.9em;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-bg-alt);
    font-size: var(--step--1);
    font-weight: 550;
  }

  .gallery {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .gallery :global(.photo) {
    border-radius: var(--radius);
  }

  @media (min-width: 56em) {
    .gallery {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .studio__gram {
    margin-top: var(--space-m);
  }

  .studio__gram a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-display);
    font-weight: 650;
  }
</style>

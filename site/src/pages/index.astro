---
// Home. Structure from docs/site-strategy.md, tightened on 3 Nov 2026 after a competitor review
// (shorter and photo-led, about 300–350 words): promise → what can we help with (needs, services,
// how it works) → team → studio and values → visit → book.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Photo from '../components/Photo.astro';
import TeamCard from '../components/TeamCard.astro';
import LocationSection from '../components/LocationSection.astro';
import SectionHead from '../components/SectionHead.astro';
import BookingBand from '../components/BookingBand.astro';
import Icon from '../components/Icon.astro';
import Todo from '../components/Todo.astro';
import { site } from '../data/site';
import { needs } from '../data/needs';
import heroPhoto from '../assets/photos/pxl-20220610-230251564-hires.webp';
import studioPhoto from '../assets/photos/pxl-20220610-231040021.webp';
import studioInsetPhoto from '../assets/photos/pxl-20220611-044952545.webp';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);

const facts = [
  { icon: 'user', text: 'One-on-one physiotherapy and exercise physiology' },
  { icon: 'users', text: 'Small group pilates classes' },
  { icon: 'shield', text: 'Physiotherapists with women’s pelvic health training' },
  { icon: 'map-pin', text: '33 Brynner Street, McDowall' },
] as const;

const steps = [
  'Start with an initial assessment',
  'Get a plan tailored to your needs and goals',
  'Keep moving with appointments, a home or gym program, or classes',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['MedicalBusiness', 'Physiotherapy'],
  name: site.name,
  url: site.url,
  image: `${site.url}/og-default.png`,
  telephone: '+61 434 686 261',
  email: site.email.address,
  slogan: 'Accept . Support . Challenge .',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.suburb,
    addressRegion: site.address.state,
    postalCode: site.address.postcode,
    addressCountry: site.address.country,
  },
  // TODO: openingHoursSpecification and sameAs (socials) once supplied.
};
---

<BaseLayout
  title="Embrace Movement Clinic | Physiotherapy, Exercise Physiology & Pilates in McDowall"
  description="Physiotherapy, pelvic floor and vestibular physiotherapy, exercise physiology and small group clinical pilates at 33 Brynner Street, McDowall QLD."
  jsonLd={jsonLd}
>
  <!-- Hero: what, where, who for -->
  <section class="on-brand hero" aria-labelledby="hero-h">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <h1 id="hero-h">Physiotherapy, exercise physiology and pilates in McDowall</h1>
        <p class="lede">We embrace everyone in their health journey, with one-on-one appointments and small group classes.</p>
        <div class="hero__actions">
          <Button href={site.booking.url} icon="calendar" size="l">Book now</Button>
          <Button href={site.phone.href} variant="secondary" size="l" icon="phone" class="hero__call">Call {site.phone.display}</Button>
          <Button href="#help" variant="secondary" size="l" class="hero__explore">What can we help with?</Button>
        </div>
      </div>
      <Photo
        src={heroPhoto}
        alt="A practitioner with Jeff, the clinic dog, at the Trapeze Table in the studio"
        position="75% 50%"
        ratio="4 / 5"
        tone="dark"
        loading="eager"
        class="hero__photo"
        sizes="(min-width: 56em) 45vw, 100vw"
      />
    </div>
    <div class="wrap">
      <ul class="facts" role="list">
        {
          facts.map((f) => (
            <li>
              <Icon name={f.icon} size={22} />
              <span>{f.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- What can we help with? Needs, then services, then how to start -->
  <section class="section" id="help" aria-labelledby="help-h">
    <div class="wrap">
      <SectionHead id="help-h" eyebrow="How we can help" title="What can we help with?" link={{ href: '/services', label: 'All services' }} />
      <ul class="needs" role="list">
        {
          needs.map((n) => (
            <li>
              <a href={`/services#${n.id}`}>
                <Icon name={n.icon} size={22} />
                <span>{n.short}</span>
                <Icon name="arrow-right" size={16} class="needs__arrow" />
              </a>
            </li>
          ))
        }
      </ul>

      <h3 class="visually-hidden">Our services</h3>
      <ul class="cards" role="list">
        {
          services.map((s) => (
            <li class:list={['card', s.data.kind === 'class' && 'card--feature']}>
              <a href={`/${s.id}`}>
                <Photo
                  src={s.data.image}
                  alt=""
                  note={s.data.imageNote}
                  position={s.data.imagePosition}
                  ratio="3 / 2"
                  widths={[400, 640, 960]}
                  sizes="(min-width: 62em) 30vw, (min-width: 40em) 50vw, 100vw"
                />
                <div class="card__body">
                  <p class="card__kind">{s.data.kind === 'class' ? 'Small group classes' : 'One-on-one'}</p>
                  <h4 class="card__title">{s.data.title}</h4>
                  <p class="card__blurb">{s.data.blurb ?? s.data.summary}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="how">
        <h3 class="how__title">How it works</h3>
        <ol class="how__steps" role="list">
          {
            steps.map((step, i) => (
              <li>
                <span class="how__n" aria-hidden="true">{i + 1}</span>
                <span>{step}</span>
              </li>
            ))
          }
        </ol>
        <a class="how__link" href="/patient-information">First visit <Icon name="arrow-right" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section section--alt" aria-labelledby="team-h">
    <div class="wrap">
      <SectionHead
        id="team-h"
        eyebrow="Our team"
        title="Who you’ll see"
        intro="Both of our physiotherapists are clinical pilates instructors with Women’s Pelvic Health Physiotherapy training (APA)."
        link={{ href: '/team', label: 'Meet the team' }}
      />
      <ul class="team-grid" role="list">
        {
          team.map((m) => (
            <li>
              <TeamCard member={m} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Studio and values -->
  <section class="section values" aria-labelledby="values-h">
    <div class="wrap values__grid">
      <div class="values__photos">
        <Photo
          src={studioPhoto}
          alt="A side stretch on the Wunda Chair in the pilates studio"
          ratio="4 / 3"
          class="values__main"
          sizes="(min-width: 56em) 45vw, 90vw"
        />
        <Photo
          src={studioInsetPhoto}
          alt="A pregnant client kneeling beside an exercise ball"
          ratio="3 / 4"
          position="50% 35%"
          widths={[300, 600]}
          class="values__inset"
          sizes="(min-width: 56em) 18vw, 40vw"
        />
      </div>
      <div class="values__text">
        <p class="eyebrow">Our approach</p>
        <h2 id="values-h" class="values__tagline">{site.tagline}</h2>
        <p class="lede">At Embrace we believe the journey of one’s health is as important as the destination.</p>
        <ul class="values__links" role="list">
          <li>
            <a href="/pilates#studio">Our studio and equipment <Icon name="arrow-right" size={16} /></a>
          </li>
          <li>
            {
              site.socials.instagram ? (
                <a href={site.socials.instagram}>
                  <Icon name="instagram" size={18} /> Follow us on Instagram
                </a>
              ) : (
                <Todo>Instagram profile link</Todo>
              )
            }
          </li>
        </ul>
      </div>
    </div>
  </section>

  <LocationSection compact />

  <BookingBand title="Book an appointment" text={`Book online, or call us on ${site.phone.display}. New to classes? Start with a pre-class assessment.`} />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) var(--space-l);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  .hero__text {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  .hero h1 {
    font-size: clamp(2.3rem, 1.4rem + 3.1vw, 3.9rem);
    line-height: 1.04;
  }

  .hero .lede {
    max-width: 32rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  /* Call on phones, "What can we help with?" on larger screens. */
  @media (min-width: 56em) {
    .hero__actions :global(.hero__call) {
      display: none;
    }
  }

  @media (max-width: 55.99em) {
    .hero__actions :global(.hero__explore) {
      display: none;
    }
  }

  :global(.hero__photo) {
    border-radius: var(--radius-l);
    max-height: 34rem;
  }

  @media (max-width: 55.99em) {
    :global(.hero__photo) {
      aspect-ratio: 4 / 3 !important;
    }
  }

  @media (min-width: 56em) {
    .hero__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-xl);
    }
  }

  .facts {
    display: grid;
    gap: var(--space-s) var(--space-m);
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    font-size: var(--step--1);
  }

  .facts li {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .facts :global(svg) {
    color: var(--color-accent-on-brand);
  }

  /* Needs: one-line tiles */
  .needs {
    display: grid;
    gap: var(--space-xs);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 48em) {
    .needs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .needs a {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 3.5rem;
    height: 100%;
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius);
    background: var(--color-bg-alt);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 650;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 0.2s var(--ease);
  }

  .needs a:hover {
    background: var(--color-accent-soft);
  }

  .needs a > :global(svg:first-child) {
    color: var(--color-icon);
  }

  .needs a > span {
    flex: 1;
  }

  .needs :global(.needs__arrow) {
    color: var(--color-ink-muted);
  }

  @media (max-width: 39.99em) {
    .needs a {
      font-size: var(--step--1);
    }

    .needs :global(.needs__arrow) {
      display: none;
    }
  }

  /* Service cards: on wide screens, four one-on-one services in a 2×2 grid beside a tall classes card */
  .cards {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-l);
  }

  @media (min-width: 40em) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .card--feature {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 40em) and (max-width: 61.99em) {
    .card--feature :global(.photo) {
      aspect-ratio: 2 / 1 !important;
    }
  }

  @media (min-width: 62em) {
    .cards {
      grid-template-columns: 1fr 1fr 1.1fr;
    }

    .card--feature {
      grid-column: 3;
      grid-row: 1 / span 2;
    }

    .cards .card--feature a {
      grid-template-rows: 1fr auto;
    }

    .card--feature :global(picture) {
      display: block;
      position: relative;
      min-height: 18rem;
    }

    .card--feature :global(.photo) {
      position: absolute;
      inset: 0;
      height: 100%;
      aspect-ratio: auto !important;
    }
  }

  .card a {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    background: var(--color-bg);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      box-shadow 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .card a:hover {
    box-shadow: var(--shadow-m);
    transform: translateY(-2px);
  }

  @media (max-width: 39.99em) {
    .cards {
      gap: var(--space-s);
    }

    .card a {
      grid-template-columns: 6.5rem 1fr;
      grid-template-rows: none;
    }

    .card :global(picture) {
      display: block;
      position: relative;
    }

    .card :global(.photo) {
      position: absolute;
      inset: 0;
      height: 100%;
      aspect-ratio: auto !important;
    }

    .card__body {
      padding: var(--space-s);
    }

    .card__title {
      font-size: var(--step-0);
    }

    .card__blurb {
      font-size: var(--step--1);
    }
  }

  .card__body {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding: var(--space-m);
  }

  .card__kind {
    color: var(--color-eyebrow);
    font-size: var(--step--1);
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .card__title {
    font-size: var(--step-1);
  }

  .card a:hover .card__title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .card__blurb {
    color: var(--color-ink-muted);
  }

  /* How it works: one slim strip */
  .how {
    display: grid;
    gap: var(--space-s) var(--space-l);
    align-items: center;
    margin-top: var(--space-l);
    padding: var(--space-m);
    border-radius: var(--radius-l);
    background: var(--color-bg-alt);
  }

  @media (min-width: 62em) {
    .how {
      grid-template-columns: auto 1fr auto;
    }
  }

  .how__title {
    font-size: var(--step-1);
  }

  .how__steps {
    display: grid;
    gap: var(--space-s) var(--space-m);
  }

  @media (min-width: 48em) {
    .how__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .how__steps li {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    font-size: var(--step--1);
    line-height: 1.45;
  }

  .how__n {
    display: inline-grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--color-brand);
    color: var(--color-on-brand);
    font-family: var(--font-display);
    font-weight: 700;
    transform: translateY(0.35em);
  }

  .how__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-family: var(--font-display);
    font-weight: 650;
    white-space: nowrap;
  }

  /* Team */
  .team-grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    max-width: 52rem;
  }

  /* Studio and values: two overlapping photos beside the tagline */
  .values__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 56em) {
    .values__grid {
      grid-template-columns: 1.15fr 1fr;
    }
  }

  .values__photos {
    position: relative;
    padding-bottom: 12%;
  }

  .values__photos :global(.values__main) {
    width: 82%;
    border-radius: var(--radius-l);
  }

  .values__photos :global(.values__inset) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 40%;
    border: 0.375rem solid var(--color-bg);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-m);
  }

  .values__text {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }

  .values__tagline {
    font-size: var(--step-4);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .values__links {
    display: grid;
    gap: var(--space-xs);
    padding-top: var(--space-2xs);
  }

  .values__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-family: var(--font-display);
    font-weight: 650;
  }
</style>

---
// Home. Structure from docs/site-strategy.md, tightened on 3 Nov 2026 after a competitor review
// (shorter and photo-led, about 300–350 words): promise → what can we help with (needs, services,
// how it works) → team → studio and values → visit → book.
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Photo from '../components/Photo.astro';
import TeamCard from '../components/TeamCard.astro';
import LocationSection from '../components/LocationSection.astro';
import SectionHead from '../components/SectionHead.astro';
import BookingBand from '../components/BookingBand.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import StepStrip from '../components/StepStrip.astro';
import Icon from '../components/Icon.astro';
import Todo from '../components/Todo.astro';
import { site } from '../data/site';
import { needs } from '../data/needs';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
// Text and photos staff can edit on /admin ("Home page").
const homeEntry = await getEntry('home', 'home');
if (!homeEntry) throw new Error('Missing src/content/home/home.md');
const home = homeEntry.data;

const factIcons = ['user', 'users', 'shield', 'map-pin'] as const;
const facts = home.facts.map((text, i) => ({ icon: factIcons[i] ?? 'check', text }));

const socialLinks = [site.socials.instagram, site.socials.facebook].filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['MedicalBusiness', 'Physiotherapy'],
  '@id': `${site.url}/#clinic`,
  name: site.name,
  url: site.url,
  image: `${site.url}/og-default.png`,
  telephone: '+61 434 686 261',
  email: site.email.address,
  slogan: 'Accept . Support . Challenge .',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.suburb,
    addressRegion: site.address.state,
    postalCode: site.address.postcode,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.address.lat, longitude: site.address.lon },
  hasMap: site.address.mapUrl,
  // Instagram and Facebook, once added on /admin (Clinic settings → Clinic details).
  ...(socialLinks.length > 0 && { sameAs: socialLinks }),
  // TODO: openingHoursSpecification once hours are supplied in a fixed format.
};
---

<BaseLayout
  title="Physiotherapy & Pilates in McDowall | Embrace Movement Clinic"
  description="Physiotherapy, pelvic health and vestibular physiotherapy, exercise therapy and small group clinical pilates at 33 Brynner Street, McDowall QLD."
  jsonLd={jsonLd}
>
  <!-- Hero: what, where, who for -->
  <section class="on-brand hero curve-bottom" aria-labelledby="hero-h">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <h1 id="hero-h">{home.heroTitle}</h1>
        <p class="lede">{home.heroIntro}</p>
        <div class="hero__actions">
          <Button href={site.booking.url} icon="calendar" size="l">Book now</Button>
          <Button href={site.phone.href} variant="secondary" size="l" icon="phone" class="phone-only">Call {site.phone.display}</Button>
          <Button href="#help" variant="secondary" size="l" class="wide-only">What can we help with?</Button>
        </div>
      </div>
      <Photo
        src={home.heroImage}
        alt={home.heroImageAlt}
        position={home.heroImagePosition}
        ratio="4 / 5"
        tone="dark"
        loading="eager"
        class="hero__photo"
        sizes="(min-width: 56em) 45vw, 100vw"
      />
    </div>
    <div class="wrap">
      <ul class="facts" role="list">
        {
          facts.map((f) => (
            <li>
              <Icon name={f.icon} size={22} />
              <span>{f.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- What can we help with? Needs, then services, then how to start -->
  <section class="section" id="help" aria-labelledby="help-h">
    <div class="wrap">
      <SectionHead id="help-h" title="What can we help with?" link={{ href: '/services', label: 'All services' }} />
      <ul class="needs" role="list">
        {
          needs.map((n) => (
            <li>
              <a href={`/services#${n.id}`}>
                <Icon name={n.icon} size={22} />
                <span>{n.short}</span>
                <Icon name="arrow-right" size={16} class="needs__arrow" />
              </a>
            </li>
          ))
        }
      </ul>

      <div class="help__cards">
        <ServiceGrid services={services} />
      </div>
      <StepStrip title="How it works" steps={home.steps} link={{ href: '/patient-information', label: 'First visit' }} class="help__steps" />
    </div>
  </section>

  <!-- Team -->
  <section class="section section--alt" aria-labelledby="team-h">
    <div class="wrap">
      <SectionHead
        id="team-h"
        title="Who you’ll see"
        intro={home.teamIntro}
        link={{ href: '/team', label: 'Meet the team' }}
      />
      <ul class="team-grid" role="list">
        {
          team.map((m) => (
            <li>
              <TeamCard member={m} ratio="4 / 3" sizes="(min-width: 75em) 37rem, (min-width: 40em) 50vw, 100vw" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Studio and values -->
  <section class="section values" aria-labelledby="values-h">
    <div class="wrap values__grid">
      <div class="values__photos">
        <Photo
          src={home.approach.image}
          alt={home.approach.imageAlt}
          ratio="4 / 3"
          class="values__main"
          sizes="(min-width: 56em) 45vw, 90vw"
        />
        <Photo
          src={home.approach.insetImage}
          alt={home.approach.insetImageAlt}
          ratio="3 / 4"
          position={home.approach.insetImagePosition}
          widths={[300, 600]}
          class="values__inset"
          sizes="(min-width: 56em) 18vw, 40vw"
        />
      </div>
      <div class="values__text">
        <p class="eyebrow">Our approach</p>
        <h2 id="values-h" class="values__tagline">{site.tagline}</h2>
        <p class="lede">{home.approach.text}</p>
        <ul class="values__links" role="list">
          <li>
            <a href="/pilates#studio">Our studio and equipment <Icon name="arrow-right" size={16} /></a>
          </li>
          <li>
            {
              site.socials.instagram ? (
                <a href={site.socials.instagram}>
                  <Icon name="instagram" size={18} /> Follow us on Instagram
                </a>
              ) : (
                <Todo>Instagram profile link</Todo>
              )
            }
          </li>
        </ul>
      </div>
    </div>
  </section>

  <LocationSection compact />

  <BookingBand title="Book an appointment" text={`Book online, or call us on ${site.phone.display}. New to classes? Start with a pre-class assessment.`} />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) calc(var(--space-l) + var(--curve) * 0.75);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  .hero__text {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  .hero h1 {
    font-size: clamp(2.3rem, 1.4rem + 3.1vw, 3.9rem);
    line-height: 1.04;
  }

  .hero .lede {
    max-width: 32rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  :global(.hero__photo) {
    border-radius: var(--radius-l);
    max-height: 34rem;
  }

  @media (max-width: 55.99em) {
    :global(.hero__photo) {
      aspect-ratio: 4 / 3 !important;
    }
  }

  @media (min-width: 56em) {
    .hero__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-xl);
    }
  }

  .facts {
    display: grid;
    gap: var(--space-s) var(--space-m);
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    font-size: var(--step--1);
  }

  .facts li {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .facts :global(svg) {
    color: var(--color-accent-on-brand);
  }

  /* Needs: one-line tiles */
  .needs {
    display: grid;
    gap: var(--space-xs);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 48em) {
    .needs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .needs a {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 3.5rem;
    height: 100%;
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius);
    background: var(--color-bg-alt);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 650;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 0.2s var(--ease);
  }

  .needs a:hover {
    background: var(--color-accent-soft);
  }

  .needs a > :global(svg:first-child) {
    color: var(--color-icon);
  }

  .needs a > span {
    flex: 1;
  }

  .needs :global(.needs__arrow) {
    color: var(--color-ink-muted);
  }

  @media (max-width: 39.99em) {
    .needs a {
      font-size: var(--step--1);
    }

    .needs :global(.needs__arrow) {
      display: none;
    }
  }

  .help__cards {
    margin-top: var(--space-l);
  }

  :global(.help__steps) {
    margin-top: var(--space-l);
  }

  /* Team */
  .team-grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: 1fr;
  }

  /* The two practitioners side by side, as on the Team page. */
  @media (min-width: 40em) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Studio and values: two overlapping photos beside the tagline */
  .values__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 56em) {
    .values__grid {
      grid-template-columns: 1.15fr 1fr;
    }
  }

  .values__photos {
    position: relative;
    padding-bottom: 12%;
  }

  .values__photos :global(.values__main) {
    width: 82%;
    border-radius: var(--radius-l);
  }

  .values__photos :global(.values__inset) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 40%;
    border: 0.375rem solid var(--color-bg);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-m);
  }

  .values__text {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }

  .values__tagline {
    font-size: var(--step-4);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .values__links {
    display: grid;
    gap: var(--space-xs);
    padding-top: var(--space-2xs);
  }

  .values__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-family: var(--font-display);
    font-weight: 650;
  }
</style>

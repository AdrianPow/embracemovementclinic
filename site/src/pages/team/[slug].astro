---
// Practitioner profile: photo and roles → status → experience → qualifications → bio → services → book.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Photo from '../../components/Photo.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import BookingBand from '../../components/BookingBand.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const team = await getCollection('team');
  return team.map((member) => ({ params: { slug: member.id }, props: { member } }));
}

interface Props {
  member: CollectionEntry<'team'>;
}

const { member } = Astro.props;
const d = member.data;
const { Content } = await render(member);
const services = (await getCollection('services', (s) => s.data.practitioners.some((p) => p.id === member.id))).sort(
  (a, b) => a.data.order - b.data.order,
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: d.name,
  jobTitle: d.titles,
  worksFor: { '@type': 'MedicalBusiness', name: site.name, url: site.url },
  url: new URL(`/team/${member.id}`, site.url).href,
};
---

<!-- Share image: the whole headshot beside the wordmark (made by scripts/make-share-images.mjs before each build). -->
<BaseLayout
  title={`${d.name}`}
  description={d.seoDescription}
  shareImage={d.photo ? `/og/team/${member.id}.jpg` : undefined}
  imageAlt={d.photo ? `${d.name}, Embrace Movement Clinic` : undefined}
  jsonLd={jsonLd}
>
  <section class="profile-hero curve-bottom" aria-labelledby="page-title">
    <div class="wrap profile-hero__grid">
      <Photo src={d.photo} alt={d.name} note={d.photoNote} position={d.photoPosition} ratio="4 / 5" loading="eager" class="profile-hero__photo" sizes="(min-width: 56em) 35vw, 100vw" />
      <div class="profile-hero__text">
        <Breadcrumbs items={[{ label: 'Team', href: '/team' }, { label: d.name }]} />
        <h1 id="page-title">{d.name}</h1>
        <ul class="roles" role="list">
          {d.titles.map((t) => <li>{t}</li>)}
        </ul>
        {d.status && <p class="status">{d.status}</p>}
        {
          d.registration && (
            <p class="ahpra">
              AHPRA registration{' '}
              <a href="https://www.ahpra.gov.au/Registration/Registers-of-Practitioners.aspx">{d.registration}</a>
            </p>
          )
        }
        <div class="actions">
          <Button href={site.booking.url} icon="calendar" size="l">Book with {d.firstName}</Button>
          <Button href={site.phone.href} variant="secondary" size="l" icon="phone">
            <span class="visually-hidden">Call </span>{site.phone.display}
          </Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="about-h">
    <div class="wrap profile">
      <aside class="profile__side" aria-label="Qualifications and experience">
        {
          d.experience.length > 0 && (
            <div class="block">
              <h2 class="h4">{d.experienceHeading}</h2>
              <ul role="list">
                {d.experience.map((e) => (
                  <li>
                    <Icon name="check" size={18} />
                    {e}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          d.education.length > 0 && (
            <div class="block">
              <h2 class="h4">Qualifications</h2>
              <ul role="list">
                {d.education.map((e) => (
                  <li>
                    <Icon name="check" size={18} />
                    {e}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          d.postgradTraining.length > 0 && (
            <div class="block">
              <h2 class="h4">Postgraduate training</h2>
              <ul role="list">
                {d.postgradTraining.map((e) => (
                  <li>
                    <Icon name="check" size={18} />
                    {e}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
      <div class="profile__main">
        <h2 id="about-h">About {d.firstName}</h2>
        <div class="prose bio">
          <Content />
        </div>
      </div>
    </div>
  </section>

  {
    services.length > 0 && (
      <section class="section section--alt" aria-labelledby="services-h">
        <div class="wrap">
          <div class="head">
            <h2 id="services-h">See {d.firstName} for</h2>
          </div>
          <ul class="services" role="list" style={`--n: ${Math.min(services.length, 4)}`}>
            {services.map((s) => (
              <li>
                <ServiceCard service={s} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <BookingBand title={`Book with ${d.firstName}`} text={`When booking online, select ${d.firstName} as your practitioner.`} bookLabel="Book now" />
</BaseLayout>

<style>
  .profile-hero {
    padding-block: clamp(2rem, 1.25rem + 3vw, 4rem) calc(clamp(2rem, 1.25rem + 3vw, 4rem) + var(--curve) * 0.5);
    background: var(--color-bg-alt);
  }

  .profile-hero__grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  @media (min-width: 56em) {
    .profile-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
      gap: var(--space-xl);
    }
  }

  /* Keeps the 4:5 portrait shape at every width (the editor previews this shape). */
  :global(.profile-hero__photo) {
    width: 100%;
    max-width: 26rem;
    border-radius: var(--radius-l);
  }

  @media (min-width: 56em) {
    :global(.profile-hero__photo) {
      max-width: none;
    }
  }

  .profile-hero__text {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }

  .profile-hero h1 {
    font-size: var(--step-5);
  }

  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .roles li {
    color: var(--color-ink-muted);
    font-weight: 550;
  }

  .roles li:not(:last-child)::after {
    content: '·';
    margin-left: var(--space-2xs);
    color: var(--color-ink-muted);
  }

  /* Phones: one title per line, so no dot is left dangling at a line end. */
  @media (max-width: 39.99em) {
    .roles {
      flex-direction: column;
      gap: 0;
    }

    .roles li::after {
      content: none !important;
    }
  }

  .status {
    padding: 0.3em 0.9em;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-ink);
    font-size: var(--step--1);
    font-weight: 650;
  }

  .ahpra {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding-top: var(--space-2xs);
  }

  .profile {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 56em) {
    .profile {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }

    .profile__side {
      order: 2;
    }
  }

  .profile__side {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }

  .block {
    display: grid;
    gap: var(--space-s);
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-line);
  }

  .block ul {
    display: grid;
    gap: var(--space-xs);
  }

  .block li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xs);
  }

  .block :global(svg) {
    margin-top: 0.2em;
    color: var(--color-icon);
  }

  .profile__main {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }

  .bio {
    font-size: var(--step-1);
    line-height: 1.65;
  }

  .head {
    display: grid;
    gap: var(--space-xs);
    margin-bottom: var(--space-l);
  }

  /* 1, then 2, then all of them (up to 4) across, so a single card never sits alone on a wide row. */
  .services {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: 1fr;
  }

  @media (min-width: 40em) {
    .services {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 75em) {
    .services {
      grid-template-columns: repeat(var(--n, 4), 1fr);
    }
  }
</style>

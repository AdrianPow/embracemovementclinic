---
// Services hub (old URL /old-services). Problem finder first, then a photo card for each service.
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import NeedsFinder from '../components/NeedsFinder.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import BookingBand from '../components/BookingBand.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
// Intro text, edited on /admin ("Pages → Services page").
const pageEntry = await getEntry('servicesPage', 'services');
if (!pageEntry) throw new Error('Missing src/content/pages/services.md');
const page = pageEntry.data;
---

<BaseLayout
  title="Services"
  description="Musculoskeletal, pelvic health and vestibular physiotherapy, exercise therapy, and clinical pilates and small group classes in McDowall."
>
  <PageHero
    crumbs={[{ label: 'Services' }]}
    title="Our services"
    lede={page.intro}
  >
    <Fragment slot="actions">
      <Button href="#help">Find help for a problem</Button>
      <Button href={site.booking.url} variant="secondary" icon="calendar" class="wide-only">Book now</Button>
      <Button href={site.phone.href} variant="secondary" icon="phone" class="phone-only">Call {site.phone.display}</Button>
    </Fragment>
  </PageHero>

  <section class="section" id="help" aria-labelledby="help-h">
    <div class="wrap">
      <SectionHead id="help-h" title="What can we help with?" intro={page.helpIntro} />
      <NeedsFinder />
    </div>
  </section>

  <section class="section section--alt" id="services" aria-labelledby="services-h">
    <div class="wrap">
      <SectionHead id="services-h" title="All services" intro={page.servicesIntro} />
      <ServiceGrid services={services} />
    </div>
  </section>

  <BookingBand title="Not sure where to start?" text={`Call or text us on ${site.phone.display} and we’ll help you choose, or book online.`} />
</BaseLayout>

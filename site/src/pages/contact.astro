---
// Contact & visit (old URL /contact-us-1). Text in src/content/pages/contact.md (edited on /admin).
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import LocationSection from '../components/LocationSection.astro';
import ClosureNote from '../components/ClosureNote.astro';
import Icon from '../components/Icon.astro';
import { site, newTabAttrs, opensNewTab } from '../data/site';

const pageEntry = await getEntry('contactPage', 'contact');
if (!pageEntry) throw new Error('Missing src/content/pages/contact.md');
const page = pageEntry.data;

const ways = [
  { icon: 'phone', title: 'Call', text: site.phone.display, href: site.phone.href, note: page.callNote },
  { icon: 'message', title: 'Text', text: site.phone.display, href: site.phone.href.replace('tel:', 'sms:'), note: page.textNote },
  { icon: 'mail', title: 'Email', text: site.email.address, href: site.email.href, note: page.emailNote },
  { icon: 'calendar', title: 'Book online', text: 'Booking portal', href: site.booking.url, note: page.bookNote },
] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  about: {
    '@type': ['MedicalBusiness', 'Physiotherapy'],
    name: site.name,
    url: site.url,
    telephone: '+61 434 686 261',
    email: site.email.address,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      addressLocality: site.address.suburb,
      addressRegion: site.address.state,
      postalCode: site.address.postcode,
      addressCountry: site.address.country,
    },
  },
};
---

<BaseLayout
  title="Contact & visit"
  description="Call, text or email Embrace Movement Clinic, or find us at 33 Brynner Street, McDowall QLD 4053. Directions, parking and hours."
  jsonLd={jsonLd}
>
  <PageHero
    crumbs={[{ label: 'Contact' }]}
    title="Get in touch"
    lede={page.intro}
  />

  <section class="section" aria-labelledby="ways-h">
    <div class="wrap">
      <h2 id="ways-h" class="visually-hidden">Ways to contact us</h2>
      <ClosureNote />
      <ul class="ways" role="list">
        {
          ways.map((w) => (
            <li>
              <a class="way hover-card" href={w.href} {...newTabAttrs(w.href)}>
                <Icon name={w.icon} size={26} />
                <span class="way__title">{w.title}</span>
                <span class:list={['way__text', { 'way__text--long': w.text.includes('@') }]}>
                  {w.text.includes('@') ? (
                    <>
                      {w.text.split('@')[0]}@<wbr />
                      {w.text.split('@')[1]}
                    </>
                  ) : (
                    <span class="nowrap">{w.text}</span>
                  )}
                </span>
                <span class="way__note">{w.note}</span>
                {opensNewTab(w.href) && <span class="visually-hidden"> (opens in a new tab)</span>}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="before">
        First time? Read <a href="/patient-information">patient information</a> for booking, cancellations and what to expect.
      </p>
    </div>
  </section>

  <LocationSection title="Find the clinic" />
</BaseLayout>

<style>
  .wrap > :global(.closure) {
    margin-bottom: var(--space-l);
  }

  /* Two by two, so the email address fits on one line and no card sits alone on a row. */
  .ways {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 48em) {
    .ways {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .way .way__text--long {
      white-space: nowrap;
    }

    /* The line-break hint after "@" is only for phones. */
    .way__text--long :global(wbr) {
      display: none;
    }
  }

  /* Tablets: a little smaller, so the address still fits on one line. */
  @media (min-width: 48em) and (max-width: 61.99em) {
    .way .way__text--long {
      font-size: var(--step--1);
    }
  }

  .way {
    display: grid;
    align-content: start;
    gap: var(--space-3xs);
    height: 100%;
    padding: var(--space-m);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    color: var(--color-ink);
    text-decoration: none;
  }

  .way :global(svg) {
    margin-bottom: var(--space-xs);
    color: var(--color-icon);
  }

  .way__title {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .way__text {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 650;
    overflow-wrap: break-word;
  }

  .way__text--long {
    font-size: var(--step-0);
  }

  .way:hover .way__text {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .way__note {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .before {
    margin-top: var(--space-l);
  }
</style>

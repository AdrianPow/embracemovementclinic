---
// Patient information: practical facts gathered from the old newsletters and pages,
// in one evergreen place. Facts live in src/data/policies.json and src/data/clinic.json;
// this page's own text in src/content/pages/patient-information.md (edited on /admin).
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Todo from '../components/Todo.astro';
import ClosureNote from '../components/ClosureNote.astro';
import BookingBand from '../components/BookingBand.astro';
import { site, fullAddress, newTabAttrs } from '../data/site';
import { cancellationPolicy, classFacts, studioEtiquette, booking, bookingTip } from '../data/policies';

const pageEntry = await getEntry('patientInfo', 'patient-information');
const teamEntry = await getEntry('teamPage', 'team');
if (!pageEntry || !teamEntry) throw new Error('Missing a file in src/content/pages');
const p = pageEntry.data;
// Fees listed together under their service, in the order they were entered.
// Each fee group heading links to its service page: matched on the service's title, short name or
// address ("Physiotherapy" → /physiotherapy), and any "class" group → the classes page.
const services = await getCollection('services');
const norm = (t: string) => t.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, ' ').trim();
const serviceFor = (group?: string) => {
  if (!group) return undefined;
  const g = norm(group);
  return (
    services.find((s) =>
      [s.data.title, s.data.shortTitle ?? '', s.id.replace(/-/g, ' '), (s.data.oldUrl ?? '').replace(/[/-]/g, ' ')].some((n) => norm(n) === g),
    ) ??
    (/\bclass/.test(g) ? services.find((s) => s.data.kind === 'class') : undefined)
  );
};
const feeGroups = p.fees.reduce<{ name?: string; fees: typeof p.fees }[]>((groups, f) => {
  const last = groups.at(-1);
  if (last && last.name === f.group) last.fees.push(f);
  else groups.push({ name: f.group, fees: [f] });
  return groups;
}, []);
const jeff = teamEntry.data.jeff;

const sections = [
  { id: 'booking', label: 'Booking' },
  { id: 'first-visit', label: 'Your first visit' },
  { id: 'cancellations', label: 'Cancellations' },
  { id: 'fees', label: 'Fees and rebates' },
  { id: 'classes', label: 'Classes' },
  { id: 'at-the-clinic', label: 'At the clinic' },
  { id: 'privacy', label: 'Your privacy' },
];
---

<BaseLayout
  title="Patient information"
  description="Booking, your first visit, cancellations, fees and rebates, class information and what to know before you visit Embrace Movement Clinic in McDowall."
>
  <PageHero
    crumbs={[{ label: 'Patient information' }]}
    eyebrow="Before you visit"
    title="Patient information"
    lede={p.intro}
  />

  <div class="section">
    <div class="wrap layout">
      <nav class="toc" aria-label="On this page">
        <p class="toc__title">On this page</p>
        <ul role="list">
          {
            sections.map((s) => (
              <li>
                <a href={`#${s.id}`}>{s.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="content">
        <ClosureNote />

        <section id="booking" aria-labelledby="booking-h" class="block">
          <h2 id="booking-h">Booking</h2>
          <div class="cards">
            <div class="card">
              <Icon name="calendar" size={24} />
              <h3 class="h4">Book online</h3>
              <p>Book appointments, pre-class assessments and classes through our online booking portal.</p>
              <div class="card__actions">
                <Button href={site.booking.url} size="s">Book now</Button>
                {booking.portalUrl && (
                  <Button href={booking.portalUrl} variant="secondary" size="s">
                    Patient portal
                  </Button>
                )}
              </div>
            </div>
            <div class="card">
              <Icon name="phone" size={24} />
              <h3 class="h4">Call or text</h3>
              <p>
                Call <a href={site.phone.href}>{site.phone.display}</a>. {booking.waitlistText}{' '}
                <a href={site.phone.href.replace('tel:', 'sms:')}>{site.phone.display}</a>.
              </p>
            </div>
            <div class="card card--wide">
              <Icon name="mail" size={24} />
              <h3 class="h4">Email</h3>
              <p><a href={site.email.href} class="email">{site.email.address.split('@')[0]}@<wbr />{site.email.address.split('@')[1]}</a></p>
            </div>
          </div>
          <p class="tip"><Icon name="info" size={20} /><span>{bookingTip.before}{bookingTip.link && <a href={bookingTip.link.href} {...newTabAttrs(bookingTip.link.href)}>{bookingTip.link.text}<span class="visually-hidden"> (opens in a new tab)</span></a>}{bookingTip.after}</span></p>
        </section>

        <section id="first-visit" aria-labelledby="first-h" class="block">
          <h2 id="first-h">Your first visit</h2>
          {p.firstVisit[0] && <p>{p.firstVisit[0]}</p>}
          <p>
            Each service page explains what to expect in more detail. See{' '}
            <a href="/services">all services</a>.
          </p>
          {p.firstVisit.slice(1).map((para) => <p>{para}</p>)}
          <h3 class="h4">What to bring</h3>
          {
            p.whatToBring.length > 0 ? (
              <ul class="list">
                {p.whatToBring.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            ) : (
              <Todo as="div">what clients should bring to a first appointment (for example a referral, health fund card or comfortable clothing)</Todo>
            )
          }
        </section>

        <section id="cancellations" aria-labelledby="cancel-h" class="block">
          <h2 id="cancel-h">Cancellations</h2>
          {cancellationPolicy.paragraphs.map((p) => <p>{p}</p>)}
        </section>

        <section id="fees" aria-labelledby="fees-h" class="block">
          <h2 id="fees-h">Fees and rebates</h2>
          {
            p.fees.length > 0 ? (
              <div class="fee-groups">
                {feeGroups.map((g) => (
                  <div class="fee-group">
                    {g.name && (
                      <h3 class="h4 fee-group__title">
                        {serviceFor(g.name) ? (
                          <a class="fee-pill" href={`/${serviceFor(g.name)!.id}`}>
                            {g.name}
                            <Icon name="arrow-right" size={18} />
                          </a>
                        ) : (
                          <span class="fee-pill">
                            {g.name}
                          </span>
                        )}
                      </h3>
                    )}
                    <dl class="fees">
                      {g.fees.map((f) => (
                        <div>
                          <dt>
                            {f.item}
                            {f.note && (
                              <>
                                {' '}
                                <span class="fee-note">{f.note}</span>
                              </>
                            )}
                          </dt>
                          <dd>{f.price}</dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                ))}
                <p class="fee-gst">Prices include GST where it applies.</p>
              </div>
            ) : (
              <Todo as="div">fees for initial and follow-up appointments, pre-class assessments and classes</Todo>
            )
          }
          {(p.feeNotes.length > 0 || p.funding.length > 0) && <h3 class="h4 rebates-h">Rebates and funding</h3>}
          {
            p.feeNotes.length > 0 && (
              <ul class="list">
                {p.feeNotes.map((note) => (
                  <li>{note}</li>
                ))}
              </ul>
            )
          }
          {
            p.funding.length > 0 ? (
              <ul class="list">
                {p.funding.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            ) : (
              <Todo as="div">whether you accept Medicare (GP care plan) referrals, DVA, NDIS or WorkCover. Add here if so.</Todo>
            )
          }
        </section>

        <section id="classes" aria-labelledby="classes-h" class="block">
          <h2 id="classes-h">Classes</h2>
          <dl class="facts">
            {
              classFacts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))
            }
          </dl>
          <p>{booking.classes}</p>
          <h3 class="h4">What to wear</h3>
          <ul class="list">
            {
              studioEtiquette.map((e) => (
                <li>
                  <strong>{/[.?!]$/.test(e.name) ? e.name : `${e.name}.`}</strong> {e.detail}
                </li>
              ))
            }
          </ul>
          <p><a href="/pilates">Pilates and class timetable</a></p>
        </section>

        <section id="at-the-clinic" aria-labelledby="clinic-h" class="block">
          <h2 id="clinic-h">At the clinic</h2>
          <dl class="facts">
            <div>
              <dt>Address</dt>
              <dd><a href={site.address.directionsUrl}>{fullAddress}</a></dd>
            </div>
            <div>
              <dt>Parking</dt>
              <dd>{site.parking ?? <Todo>parking details</Todo>}</dd>
            </div>
            {
              site.access && (
                <div>
                  <dt>Access</dt>
                  <dd>{site.access}</dd>
                </div>
              )
            }
          </dl>
          <h3 class="h4"><Icon name="paw" size={18} /> {jeff.heading}</h3>
          <p>{[jeff.text, jeff.extra].filter(Boolean).join(' ')}</p>
        </section>

        <section id="privacy" aria-labelledby="privacy-h" class="block">
          <h2 id="privacy-h">Your privacy</h2>
          <p>{p.privacy}</p>
          <p><a href="/privacy">Read our privacy policy</a></p>
        </section>
      </div>
    </div>
  </div>

  <BookingBand />
</BaseLayout>

<style>
  .layout {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 62em) {
    .layout {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: var(--space-xl);
      align-items: start;
    }

    .toc {
      position: sticky;
      top: calc(var(--header-h) + var(--space-m));
    }
  }

  .toc {
    padding: var(--space-m);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
  }

  .toc__title {
    margin-bottom: var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-s);
  }

  @media (min-width: 62em) {
    .toc ul {
      display: grid;
    }
  }

  .toc a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    font-weight: 550;
  }

  .content {
    display: grid;
    gap: var(--space-xl);
    max-width: 50rem;
  }

  .block {
    display: grid;
    gap: var(--space-s);
    scroll-margin-top: calc(var(--header-h) + var(--space-m));
  }

  .block h2 {
    font-size: var(--step-3);
  }

  .block h3 {
    display: flex;
    align-items: center;
    gap: 0.4em;
    margin-top: var(--space-xs);
  }

  .block > p {
    max-width: var(--measure);
  }

  /* Book online and Call or text side by side; Email as a strip underneath, so the address
     fits on one line. */
  .cards {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 40em) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .card--wide {
      grid-column: 1 / -1;
      grid-template-columns: auto auto 1fr;
      align-items: center;
      column-gap: var(--space-s);
    }

    .card--wide .email {
      white-space: nowrap;
    }

    .card--wide .email :global(wbr) {
      display: none;
    }
  }

  .card {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
    justify-items: start;
    padding: var(--space-m);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    background: var(--color-bg);
  }

  .card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .card :global(svg) {
    color: var(--color-icon);
  }

  .card p {
    color: var(--color-ink-muted);
  }

  .email {
    overflow-wrap: break-word;
  }

  .tip {
    display: flex;
    gap: var(--space-xs);
    align-items: flex-start;
    padding: var(--space-m);
    border-radius: var(--radius-l);
    background: var(--color-accent-soft);
  }

  .tip :global(svg) {
    margin-top: 0.15em;
    flex-shrink: 0;
    color: var(--color-icon);
  }

  .list {
    display: grid;
    gap: var(--space-xs);
    padding-left: 1.25em;
  }

  .list li::marker {
    color: var(--color-icon);
  }

  .facts {
    display: grid;
  }

  .facts div {
    display: grid;
    gap: var(--space-3xs);
    padding-block: var(--space-xs);
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 40em) {
    .facts div {
      grid-template-columns: 10rem 1fr;
      gap: var(--space-s);
    }
  }

  /* Fees: one short price list per service, prices right-aligned. */
  .fee-groups {
    display: grid;
    gap: var(--space-l);
    margin-bottom: var(--space-l);
  }

  @media (min-width: 48em) {
    .fee-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-l) var(--space-xl);
    }
  }

  .fee-group__title {
    margin-bottom: var(--space-xs);
  }

  /* Service name as a petrol pill linking to its page. */
  .fee-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.3em 0.9em;
    border-radius: 999px;
    background: var(--color-brand);
    color: var(--color-on-brand);
    text-decoration: none;
    transition:
      box-shadow 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  @media (hover: hover) {
    a.fee-pill:hover {
      box-shadow: var(--shadow-m);
      transform: translateY(-1px);
    }
  }

  .fees div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
    padding-block: var(--space-xs);
    border-top: 1px solid var(--color-line);
  }

  .fees dd {
    font-family: var(--font-display);
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .fee-gst {
    grid-column: 1 / -1;
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .rebates-h {
    margin-bottom: var(--space-2xs);
  }

  .rebates-h + .list + .list {
    margin-top: var(--space-xs);
  }

  .fee-note {
    display: block;
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .facts dt {
    font-family: var(--font-display);
    font-weight: 650;
  }

  .facts dd {
    margin: 0;
  }
</style>

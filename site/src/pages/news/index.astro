---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';

const posts = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// The first photo in a post (or its closing photo) as the card's picture. Decorative here: the
// post title says what the card is, and the photos are described on the post itself.
const cover = (p: (typeof posts)[number]) => p.data.images[0] ?? p.data.closingImage;
const month = (d: Date) => d.toLocaleDateString('en-AU', { month: 'long', year: 'numeric', timeZone: 'Australia/Brisbane' });
---

<BaseLayout
  title="Clinic news"
  description="Updates and newsletters from Embrace Movement Clinic in McDowall, including clinic closures and reopening, holiday hours, classes and team news."
>
  <PageHero crumbs={[{ label: 'News' }]} title="Clinic news" lede="Updates and newsletters from the clinic." />

  <section class="section" aria-labelledby="posts-h">
    <div class="wrap">
      <h2 id="posts-h" class="visually-hidden">All posts</h2>
      {posts.length === 0 && <p class="empty">No updates right now. New clinic updates will appear here.</p>}
      <ol class="posts" role="list">
        {
          posts.map((p) => (
            <li>
              <a class:list={['post', { 'post--photo': cover(p) }]} href={`/news/${p.id}`}>
                {cover(p) && (
                  <Photo src={cover(p)!.src} alt="" position={cover(p)!.position} ratio="4 / 3" class="post__photo" widths={[400, 640, 800]} sizes="(min-width: 48em) 20rem, 100vw" />
                )}
                <span class="post__text">
                  <time datetime={p.data.date.toISOString().slice(0, 10)}>{month(p.data.date)}</time>
                  <span class="post__title">{p.data.title}</span>
                  <span class="post__summary">{p.data.summary}</span>
                  {p.data.archivedNote && <span class="post__badge">Archived</span>}
                  <span class="post__more">
                    Read the update <Icon name="arrow-right" size={18} />
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .empty {
    color: var(--color-ink-muted);
    font-size: var(--step-1);
  }

  .posts {
    display: grid;
    gap: var(--space-m);
    max-width: 60rem;
  }

  /* Each post as a card: photo on the left (on top on phones), then date, title and summary. */
  .post {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    background: var(--color-bg);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      border-color 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  @media (min-width: 48em) {
    .post--photo {
      grid-template-columns: 20rem minmax(0, 1fr);
    }
  }

  @media (hover: hover) {
    .post:hover {
      border-color: var(--color-icon);
      box-shadow: var(--shadow-m);
    }

    .post:hover .post__title {
      text-decoration: underline;
      text-underline-offset: 0.15em;
    }
  }

  .post :global(.post__photo) {
    height: 100%;
  }

  .post__text {
    display: grid;
    gap: var(--space-2xs);
    align-content: center;
    padding: var(--space-m) var(--space-l);
  }

  .post time {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--color-ink-muted);
  }

  .post__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .post__summary {
    color: var(--color-ink-muted);
  }

  .post__badge {
    justify-self: start;
    padding: 0.15em 0.7em;
    border-radius: var(--radius-pill);
    background: var(--color-bg-alt);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .post__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-top: var(--space-2xs);
    color: var(--color-link, var(--color-brand));
    font-family: var(--font-display);
    font-weight: 650;
  }
</style>
